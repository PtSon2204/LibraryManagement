@model LibraryManagement.MVC.ViewModels.Fines.FineListPageViewModel

@{
    ViewData["Title"] = "Quản lý khoản phạt";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0">Lịch sử thu tiền phạt</h2>
    <a asp-action="Templates" class="btn btn-outline-brand">
        <i class="bi bi-gear me-2"></i>Cấu hình loại phạt
    </a>
</div>

<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-4">
        <form asp-action="Index" method="get" class="row g-3">
            <div class="col-md-5">
                <input type="text" class="form-control" name="search" value="@Model.Search" placeholder="Tìm tên sách, barcode, email, lý do..." />
            </div>
            <div class="col-md-3">
                <select class="form-select" name="status">
                    <option value="">Tất cả trạng thái</option>
                    <option value="Paid" selected="@(Model.Status == "Paid")">Đã thanh toán</option>
                    <option value="Unpaid" selected="@(Model.Status == "Unpaid")">Chưa thanh toán</option>
                </select>
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-brand w-100">Tìm kiếm</button>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Ngày thu</th>
                        <th>Độc giả</th>
                        <th>Sách (Barcode)</th>
                        <th>Lý do</th>
                        <th>Số tiền</th>
                        <th>HT Thanh toán</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Fines.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">Không tìm thấy khoản phạt nào.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var fine in Model.Fines)
                        {
                            <tr>
                                <td class="ps-4">@fine.PaidAt?.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <div class="fw-semibold">@fine.ReaderName</div>
                                    <div class="small text-muted">@fine.ReaderEmail</div>
                                </td>
                                <td>
                                    <div>@fine.BookTitle</div>
                                    <span class="badge text-bg-light">@fine.Barcode</span>
                                </td>
                                <td>@fine.Reason</td>
                                <td class="fw-bold text-danger">@fine.Amount.ToString("N0")đ</td>
                                <td>
                                    @if (fine.PaymentMethod == "Transfer")
                                    {
                                        <span class="badge bg-info text-dark"><i class="bi bi-qr-code-scan me-1"></i>Chuyển khoản</span>
                                    }
                                    else if (fine.PaymentMethod == "Cash")
                                    {
                                        <span class="badge bg-success"><i class="bi bi-cash-stack me-1"></i>Tiền mặt</span>
                                    }
                                    else
                                    {
                                        <span>@fine.PaymentMethod</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
    
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white border-0 p-4">
            <nav aria-label="Page navigation">
                <ul class="pagination justify-content-end mb-0">
                    <li class="page-item @(Model.Page == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page - 1)" asp-route-search="@Model.Search" asp-route-status="@Model.Status">Trước</a>
                    </li>
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.Page ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-search="@Model.Search" asp-route-status="@Model.Status">@i</a>
                        </li>
                    }
                    <li class="page-item @(Model.Page == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page + 1)" asp-route-search="@Model.Search" asp-route-status="@Model.Status">Sau</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
