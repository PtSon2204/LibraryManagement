@model LibraryManagement.MVC.ViewModels.Books.BookDetailViewModel

@{
    ViewData["Title"] = Model.Title;
}

<section class="public-page-hero py-5">
    <div class="container">
        <a asp-controller="Books" asp-action="Index" class="text-success text-decoration-none fw-semibold d-inline-flex align-items-center mb-4">
            <i class="bi bi-arrow-left me-2"></i>Quay lại danh sách sách
        </a>

        <div class="row g-5 align-items-start">
            <div class="col-md-4 col-lg-3">
                <div class="book-card shadow-sm">
                    <div class="book-cover">
                        <span class="book-badge">@(Model.Language ?? "N/A")</span>
                        @if (!string.IsNullOrWhiteSpace(Model.CoverImageUrl))
                        {
                            <img src="@Model.CoverImageUrl" alt="@Model.Title" />
                        }
                        else
                        {
                            <div class="book-cover-placeholder">Book</div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-md-8 col-lg-9">
                <div class="d-flex flex-column flex-lg-row justify-content-between gap-4">
                    <div>
                        <h1 class="display-5 fw-bold mb-3">@Model.Title</h1>
                        <p class="lead text-muted mb-4">@(Model.Description ?? "Chưa có mô tả cho sách này.")</p>
                    </div>

                    <div class="card border-0 shadow-sm rounded-4 flex-shrink-0" style="min-width: 260px;">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted">Có sẵn</span>
                                <strong>@Model.AvailableCopies / @Model.TotalCopies</strong>
                            </div>
                            @if (User.IsInRole("Reader") && Model.AvailableCopies > 0)
                            {
                                <form asp-controller="Loans" asp-action="Borrow" method="post" class="mt-3">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="bookId" value="@Model.BookId" />
                                    <button type="submit" class="btn btn-brand w-100">Gửi yêu cầu mượn</button>
                                </form>
                            }
                            else if (User.Identity?.IsAuthenticated != true)
                            {
                                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-brand w-100 mt-3">Đăng nhập để yêu cầu mượn</a>
                            }
                            else if (Model.AvailableCopies <= 0)
                            {
                                <button class="btn btn-outline-secondary w-100 mt-3" disabled>Hết bản có sẵn</button>
                            }
                        </div>
                    </div>
                </div>

                <div class="row g-3 mt-4">
                    <div class="col-sm-6 col-lg-3">
                        <div class="card border-0 shadow-sm rounded-4 h-100"><div class="card-body"><div class="text-muted small">ISBN</div><div class="fw-semibold">@(Model.ISBN ?? "N/A")</div></div></div>
                    </div>
                    <div class="col-sm-6 col-lg-3">
                        <div class="card border-0 shadow-sm rounded-4 h-100"><div class="card-body"><div class="text-muted small">Nhà xuất bản</div><div class="fw-semibold">@(Model.PublisherName ?? "Chưa có")</div></div></div>
                    </div>
                    <div class="col-sm-6 col-lg-3">
                        <div class="card border-0 shadow-sm rounded-4 h-100"><div class="card-body"><div class="text-muted small">Năm xuất bản</div><div class="fw-semibold">@(Model.PublicationYear?.ToString() ?? "N/A")</div></div></div>
                    </div>
                    <div class="col-sm-6 col-lg-3">
                        <div class="card border-0 shadow-sm rounded-4 h-100"><div class="card-body"><div class="text-muted small">Phiên bản</div><div class="fw-semibold">@(Model.Edition ?? "N/A")</div></div></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="container py-5">
    <div class="row g-4">
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <h2 class="h5 fw-bold mb-3">Tác giả</h2>
                    @if (Model.Authors.Any())
                    {
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var author in Model.Authors)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle">@author</span>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-0">Chưa có thông tin tác giả.</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <h2 class="h5 fw-bold mb-3">Thể loại</h2>
                    @if (Model.Categories.Any())
                    {
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var category in Model.Categories)
                            {
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle">@category</span>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-0">Chưa có thông tin thể loại.</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 mt-4">
        <div class="card-header public-card-header border-0 p-4">
            <h2 class="h5 fw-bold mb-1">Vị trí trong thư viện</h2>
            <p class="text-muted small mb-0">Hiển thị số lượng bản có sẵn theo kệ, không bao gồm mã quản lý nội bộ.</p>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Vị trí</th>
                            <th>Có sẵn</th>
                            <th>Tổng bản</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var location in Model.LocationAvailability)
                        {
                            <tr>
                                <td class="fw-semibold">@location.Location</td>
                                <td><span class="badge bg-success-subtle text-success">@location.AvailableCopies</span></td>
                                <td>@location.TotalCopies</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @if (User.IsInRole("Librarian") || User.IsInRole("Admin"))
    {
        <div class="card border-0 shadow-sm rounded-4 mt-4">
            <div class="card-header public-card-header border-0 p-4">
                <h2 class="h5 fw-bold mb-1">Bản sao nội bộ</h2>
                <p class="text-muted small mb-0">Thông tin mã bản sao chỉ dành cho thủ thư và quản trị viên.</p>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Mã bản sao</th>
                                <th>Vị trí</th>
                                <th>Ngày nhập</th>
                                <th>Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var copy in Model.Copies)
                            {
                                <tr>
                                    <td class="fw-semibold">@copy.Barcode</td>
                                    <td>@(copy.Location ?? "N/A")</td>
                                    <td>@copy.AddedDate.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        @if (copy.Status == "Available")
                                        {
                                            <span class="badge bg-success-subtle text-success">Có sẵn</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary">@copy.Status</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>
