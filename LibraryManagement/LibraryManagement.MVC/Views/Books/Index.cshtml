@model LibraryManagement.MVC.ViewModels.Books.BookListPageViewModel

@{
    ViewData["Title"] = "Danh sách sách";
}

<div class="container mt-5 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="section-heading mb-1">Danh sách sách</h1>
            <p class="text-muted mb-0">Tìm kiếm, lọc và xem tình trạng sách trong thư viện.</p>
        </div>
    </div>

    <form method="get" asp-controller="Books" asp-action="Index" class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label" for="Title">Tên sách</label>
                    <input class="form-control" id="Title" name="Title" value="@Model.Search.Title" placeholder="Nhập tên sách" />
                </div>
                <div class="col-md-2">
                    <label class="form-label" for="Language">Ngôn ngữ</label>
                    <select class="form-select" id="Language" name="Language">
                        <option value="" selected="@(string.IsNullOrWhiteSpace(Model.Search.Language))">Tất cả</option>
                        <option value="Vietnamese" selected="@(Model.Search.Language == "Vietnamese")">Tiếng Việt</option>
                        <option value="English" selected="@(Model.Search.Language == "English")">Tiếng Anh</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="Publisher">Nhà xuất bản</label>
                    <input class="form-control" id="Publisher" name="Publisher" value="@Model.Search.Publisher" placeholder="Nhập NXB" />
                </div>
                <div class="col-md-2">
                    <label class="form-label" for="SortBy">Sắp xếp</label>
                    <select class="form-select" id="SortBy" name="SortBy">
                        <option value="" selected="@(string.IsNullOrWhiteSpace(Model.Search.SortBy))">Tên A-Z</option>
                        <option value="title_desc" selected="@(Model.Search.SortBy == "title_desc")">Tên Z-A</option>
                        <option value="year_desc" selected="@(Model.Search.SortBy == "year_desc")">Năm mới nhất</option>
                        <option value="year_asc" selected="@(Model.Search.SortBy == "year_asc")">Năm cũ nhất</option>
                        <option value="available_desc" selected="@(Model.Search.SortBy == "available_desc")">Còn nhiều nhất</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" id="AvailableOnly" name="AvailableOnly" value="true" checked="@Model.Search.AvailableOnly" />
                        <label class="form-check-label" for="AvailableOnly">Chỉ sách còn</label>
                    </div>
                </div>
                <input type="hidden" name="Page" value="1" />
                <input type="hidden" name="PageSize" value="@Model.Search.PageSize" />
            </div>
            <div class="d-flex gap-2 mt-3">
                <button class="btn btn-brand" type="submit">Tìm kiếm</button>
                <a class="btn btn-outline-secondary" asp-controller="Books" asp-action="Index">Xóa lọc</a>
            </div>
        </div>
    </form>

    <p class="text-muted">Tìm thấy <strong>@Model.TotalCount</strong> sách.</p>

    @if (!Model.Books.Any())
    {
        <div class="alert alert-info">Không tìm thấy sách phù hợp.</div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">
            @foreach (var book in Model.Books)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0">
                        <img src="@(book.CoverImageUrl ?? "https://via.placeholder.com/300x420/e2e8f0/64748b?text=Book")"
                             class="card-img-top"
                             alt="@book.Title"
                             style="height: 260px; object-fit: cover;" />
                        <div class="card-body">
                            <h5 class="card-title">@book.Title</h5>
                            <p class="card-text mb-1"><strong>ISBN:</strong> @(book.ISBN ?? "N/A")</p>
                            <p class="card-text mb-1"><strong>NXB:</strong> @(book.PublisherName ?? "N/A")</p>
                            <p class="card-text mb-1"><strong>Năm:</strong> @(book.PublicationYear?.ToString() ?? "N/A")</p>
                            <p class="card-text mb-1"><strong>Ngôn ngữ:</strong> @(book.Language ?? "N/A")</p>
                            <p class="card-text"><strong>Còn:</strong> @book.AvailableCopies / @book.TotalCopies</p>
                        </div>
                        <div class="card-footer bg-white border-0">
                            <a asp-controller="Books" asp-action="Details" asp-route-id="@book.BookId" class="btn btn-outline-brand w-100">Xem chi tiết</a>
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav class="mt-4" aria-label="Book pagination">
                <ul class="pagination justify-content-center">
                    @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
                    {
                        <li class="page-item @(pageNumber == Model.Search.Page ? "active" : string.Empty)">
                            <a class="page-link"
                               asp-controller="Books"
                               asp-action="Index"
                               asp-route-Title="@Model.Search.Title"
                               asp-route-Language="@Model.Search.Language"
                               asp-route-Publisher="@Model.Search.Publisher"
                               asp-route-AvailableOnly="@Model.Search.AvailableOnly"
                               asp-route-SortBy="@Model.Search.SortBy"
                               asp-route-Page="@pageNumber"
                               asp-route-PageSize="@Model.Search.PageSize">@pageNumber</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    }
</div>
