@model LibraryManagement.MVC.ViewModels.Dashboard.StaffDashboardViewModel

@{
    ViewData["Title"] = "Staff Dashboard";
}

<div class="container mt-5 mb-5">
    <h1 class="section-heading mb-4">Staff Dashboard</h1>

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card text-bg-primary h-100">
                <div class="card-body">
                    <h5>Tổng đầu sách</h5>
                    <h2>@Model.TotalBooks</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-bg-success h-100">
                <div class="card-body">
                    <h5>Bản sao khả dụng</h5>
                    <h2>@Model.AvailableCopies khả dụng</h2>
                    <div>@Model.TotalCopies tổng bản sao</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-bg-warning h-100">
                <div class="card-body">
                    <h5>Sách đang được mượn</h5>
                    <h2>@Model.ActiveLoans</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-bg-danger h-100">
                <div class="card-body">
                    <h5>Lượt mượn quá hạn</h5>
                    <h2>@Model.OverdueLoans</h2>
                </div>
            </div>
        </div>
    </div>

    @if (Model.OverdueLoans > 0 || Model.PendingReservations > 0 || Model.UnpaidFines > 0)
    {
        <div class="mb-4">
            @if (Model.OverdueLoans > 0)
            {
                <div class="alert alert-danger mb-2">Có @Model.OverdueLoans lượt mượn quá hạn cần nhắc.</div>
            }
            @if (Model.PendingReservations > 0)
            {
                <div class="alert alert-warning mb-2">Có @Model.PendingReservations yêu cầu đặt sách đang chờ xử lý.</div>
            }
            @if (Model.UnpaidFines > 0)
            {
                <div class="alert alert-info mb-2">Có @Model.UnpaidFines khoản phạt chưa thanh toán.</div>
            }
        </div>
    }

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h5>Thành viên thư viện</h5>
                    <h3>@Model.TotalUsers</h3>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h5>Yêu cầu đặt sách chờ xử lý</h5>
                    <h3>@Model.PendingReservations</h3>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h5>Khoản phạt chưa thanh toán</h5>
                    <h3>@Model.UnpaidFines</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-6">
            <h3>Mượn sách gần đây</h3>
            @if (!Model.RecentLoans.Any())
            {
                <div class="alert alert-info">Chưa có lượt mượn gần đây.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped align-middle">
                        <thead>
                            <tr>
                                <th>Người mượn</th>
                                <th>Ngày mượn</th>
                                <th>Hạn trả</th>
                                <th>Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var loan in Model.RecentLoans)
                            {
                                <tr>
                                    <td>@loan.BorrowerName</td>
                                    <td>@loan.BorrowedAt.ToString("dd/MM/yyyy")</td>
                                    <td>@loan.DueAt.ToString("dd/MM/yyyy")</td>
                                    <td>@loan.Status</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
        <div class="col-lg-6">
            <h3>Đặt sách gần đây</h3>
            @if (!Model.RecentReservations.Any())
            {
                <div class="alert alert-info">Chưa có đặt sách gần đây.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped align-middle">
                        <thead>
                            <tr>
                                <th>Người đặt</th>
                                <th>Sách</th>
                                <th>Ngày đặt</th>
                                <th>Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var reservation in Model.RecentReservations)
                            {
                                <tr>
                                    <td>@reservation.UserName</td>
                                    <td>@reservation.BookTitle</td>
                                    <td>@reservation.ReservationDate.ToString("dd/MM/yyyy")</td>
                                    <td>@reservation.Status</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
