@model LibraryManagement.MVC.ViewModels.BookCopies.BookCopyListViewModel

@{
    ViewData["Title"] = "Quản lý bản sao – " + Model.BookTitle;
    Layout = User.IsInRole("Admin") ? "~/Views/Shared/_AdminLayout.cshtml" : "~/Views/Shared/_LibrarianLayout.cshtml";
}

@* ── Breadcrumb ─────────────────────────────────────────────────────────── *@
<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a asp-controller="Book" asp-action="Index" class="text-decoration-none">
                <i class="bi bi-book me-1"></i>Danh sách sách
            </a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">Quản lý bản sao</li>
    </ol>
</nav>

@* ── Book info card ──────────────────────────────────────────────────────── *@
<div class="card border-0 shadow-sm rounded-3 mb-4" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
    <div class="card-body p-4 text-white">
        <div class="d-flex justify-content-between align-items-start">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <i class="bi bi-book-half fs-4 opacity-75"></i>
                    <span class="small opacity-75 text-uppercase fw-semibold letter-spacing-1">Thông tin sách</span>
                </div>
                <h4 class="fw-bold mb-1">@Model.BookTitle</h4>
                @if (!string.IsNullOrWhiteSpace(Model.BookISBN))
                {
                    <div class="opacity-75 small">
                        <i class="bi bi-upc me-1"></i>ISBN: <span class="fw-semibold">@Model.BookISBN</span>
                    </div>
                }
            </div>
            <div class="text-end">
                <div class="bg-white bg-opacity-25 rounded-3 px-3 py-2">
                    <div class="fs-2 fw-bold">@Model.TotalRecords</div>
                    <div class="small opacity-75">bản sao</div>
                </div>
            </div>
        </div>
    </div>
</div>

@* ── Actions + Filter row ────────────────────────────────────────────────── *@
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div class="d-flex align-items-center gap-2">
        <h5 class="mb-0 fw-bold">
            <i class="bi bi-collection me-2 text-primary"></i>Danh sách bản sao
        </h5>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-primary btn-sm px-3" onclick="openCreateModal()">
            <i class="bi bi-plus-lg me-1"></i>Thêm 1 bản sao
        </button>
        <button class="btn btn-outline-primary btn-sm px-3" onclick="openGenerateModal()">
            <i class="bi bi-layers me-1"></i>Thêm nhiều bản sao
        </button>
    </div>
</div>

@* ── Filter ──────────────────────────────────────────────────────────────── *@
<div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <input type="hidden" name="bookId" value="@Model.BookId" />
            <input type="hidden" name="pageSize" value="@Model.PageSize" />

            <div class="col-md-4">
                <label class="form-label small text-muted mb-1">Tìm theo Barcode / Tên sách</label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0">
                        <i class="bi bi-search text-muted"></i>
                    </span>
                    <input type="text" name="searchTerm" class="form-control border-start-0 ps-0"
                           placeholder="Nhập barcode..." value="@Model.SearchTerm" />
                </div>
            </div>

            <div class="col-md-3">
                <label class="form-label small text-muted mb-1">Trạng thái</label>
                <select name="statusFilter" class="form-select">
                    <option value="">— Tất cả —</option>
                    @foreach (var s in new[] { "Available", "Borrowed", "Lost", "Damaged", "Hidden" })
                    {
                        <option value="@s" selected="@(Model.StatusFilter == s ? "selected" : null)">@s</option>
                    }
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label small text-muted mb-1">Vị trí</label>
                <input type="text" name="locationFilter" class="form-control"
                       placeholder="VD: Shelf A01" value="@Model.LocationFilter" />
            </div>

            <div class="col-md-auto d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-funnel me-1"></i>Lọc
                </button>
                @if (!string.IsNullOrWhiteSpace(Model.SearchTerm) || !string.IsNullOrWhiteSpace(Model.StatusFilter) || !string.IsNullOrWhiteSpace(Model.LocationFilter))
                {
                    <a asp-action="Index" asp-route-bookId="@Model.BookId" class="btn btn-outline-secondary">
                        <i class="bi bi-x-lg"></i>
                    </a>
                }
            </div>
        </form>
    </div>
</div>

@* ── Table ───────────────────────────────────────────────────────────────── *@
<div class="card border-0 shadow-sm rounded-3">
    <div class="card-body p-0">
        @if (!Model.Data.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-collection fs-1 text-muted opacity-50"></i>
                <p class="text-muted mt-3">Chưa có bản sao nào cho sách này.</p>
                <button class="btn btn-primary btn-sm" onclick="openCreateModal()">
                    <i class="bi bi-plus-lg me-1"></i>Thêm bản sao đầu tiên
                </button>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4" style="width:50px;">#</th>
                            <th>Barcode</th>
                            <th>Trạng thái</th>
                            <th>Vị trí</th>
                            <th>Ngày nhập</th>
                            <th class="text-center pe-4" style="width:180px;">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var stt = (Model.PageNumber - 1) * Model.PageSize + 1;
                        }
                        @foreach (var item in Model.Data)
                        {
                            <tr>
                                <td class="ps-4 text-muted">@(stt++)</td>
                                <td>
                                    <span class="badge bg-light text-dark border fw-semibold font-monospace fs-6 px-3 py-2">
                                        <i class="bi bi-qr-code me-1 opacity-50"></i>@item.Barcode
                                    </span>
                                </td>
                                <td>
                                    @{
                                        var (badgeClass, icon) = item.Status switch
                                        {
                                            "Available" => ("bg-success", "bi-check-circle-fill"),
                                            "Borrowed"  => ("bg-warning text-dark", "bi-arrow-left-right"),
                                            "Lost"      => ("bg-danger", "bi-x-octagon-fill"),
                                            "Damaged"   => ("bg-secondary", "bi-tools"),
                                            "Hidden"    => ("bg-dark", "bi-eye-slash-fill"),
                                            _           => ("bg-light text-dark", "bi-question-circle")
                                        };
                                    }
                                    <span class="badge @badgeClass">
                                        <i class="bi @icon me-1"></i>@item.Status
                                    </span>
                                </td>
                                <td class="text-muted">
                                    @if (!string.IsNullOrWhiteSpace(item.Location))
                                    {
                                        <span><i class="bi bi-geo-alt me-1"></i>@item.Location</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted opacity-50">—</span>
                                    }
                                </td>
                                <td class="text-muted small">
                                    <i class="bi bi-calendar3 me-1"></i>@item.AddedDate.ToString("dd/MM/yyyy")
                                </td>
                                <td class="text-center pe-4">
                                    <div class="d-flex justify-content-center gap-1">
                                        <button class="btn btn-sm btn-outline-warning" title="Chỉnh sửa"
                                                onclick="openEditModal('@item.CopyId')">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <button class="btn btn-sm @(item.Status == "Hidden" ? "btn-outline-success" : "btn-outline-secondary")"
                                                    title="@(item.Status == "Hidden" ? "Hiện bản sao" : "Ẩn bản sao")"
                                                    onclick="toggleHide('@item.CopyId')">
                                                <i class="bi @(item.Status == "Hidden" ? "bi-eye" : "bi-eye-slash")"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger" title="Xóa"
                                                    onclick="confirmDelete('@item.CopyId', '@item.Barcode')">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @* ── Pagination ──────────────────────────────────────────────────── *@
            @if (Model.TotalPages > 1)
            {
                <div class="d-flex justify-content-between align-items-center px-4 py-3 border-top">
                    <small class="text-muted">
                        Trang @Model.PageNumber / @Model.TotalPages
                        &nbsp;•&nbsp; @Model.TotalRecords bản sao
                    </small>
                    <nav>
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-bookId="@Model.BookId"
                                   asp-route-searchTerm="@Model.SearchTerm"
                                   asp-route-statusFilter="@Model.StatusFilter"
                                   asp-route-locationFilter="@Model.LocationFilter"
                                   asp-route-pageNumber="@(Model.PageNumber - 1)"
                                   asp-route-pageSize="@Model.PageSize">
                                    <i class="bi bi-chevron-left"></i>
                                </a>
                            </li>
                            @for (int i = Math.Max(1, Model.PageNumber - 2); i <= Math.Min(Model.TotalPages, Model.PageNumber + 2); i++)
                            {
                                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-route-bookId="@Model.BookId"
                                       asp-route-searchTerm="@Model.SearchTerm"
                                       asp-route-statusFilter="@Model.StatusFilter"
                                       asp-route-locationFilter="@Model.LocationFilter"
                                       asp-route-pageNumber="@i"
                                       asp-route-pageSize="@Model.PageSize">@i</a>
                                </li>
                            }
                            <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-bookId="@Model.BookId"
                                   asp-route-searchTerm="@Model.SearchTerm"
                                   asp-route-statusFilter="@Model.StatusFilter"
                                   asp-route-locationFilter="@Model.LocationFilter"
                                   asp-route-pageNumber="@(Model.PageNumber + 1)"
                                   asp-route-pageSize="@Model.PageSize">
                                    <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        }
    </div>
</div>

@* ── Modal container ─────────────────────────────────────────────────────── *@
<div class="modal fade" id="copyModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div id="copyModalBody"></div>
        </div>
    </div>
</div>

@* ── Confirm Delete Modal ────────────────────────────────────────────────── *@
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h6 class="modal-title fw-bold text-danger">
                    <i class="bi bi-exclamation-triangle me-2"></i>Xác nhận xóa
                </h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                Bạn có chắc muốn xóa bản sao <strong id="deleteBarcodeLabel"></strong> không?
                Hành động này không thể hoàn tác.
            </div>
            <div class="modal-footer border-0 pt-0">
                <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Hủy</button>
                <button class="btn btn-danger btn-sm" id="confirmDeleteBtn">
                    <i class="bi bi-trash me-1"></i>Xóa
                </button>
            </div>
        </div>
    </div>
</div>

@* ── Toast ───────────────────────────────────────────────────────────────── *@
<div class="position-fixed bottom-0 end-0 p-3" style="z-index: 2000">
    <div id="toastMsg" class="toast align-items-center border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body fw-medium" id="toastText"></div>
            <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const copyModal  = new bootstrap.Modal(document.getElementById('copyModal'));
        const deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));
        const toast = new bootstrap.Toast(document.getElementById('toastMsg'), { delay: 3000 });
        const bookId = '@Model.BookId';
        let pendingDeleteId = null;

        // ── Toast ──────────────────────────────────────────────────────────────

        function showToast(message, isSuccess) {
            const el = document.getElementById('toastMsg');
            el.classList.remove('bg-success', 'bg-danger', 'text-white');
            el.classList.add(isSuccess ? 'bg-success' : 'bg-danger', 'text-white');
            document.getElementById('toastText').textContent = message;
            toast.show();
        }

        // ── Open Create (Add One Copy) ─────────────────────────────────────────

        function openCreateModal() {
            fetch('@Url.Action("GetCreateForm", "BookCopies")' + '?bookId=' + bookId)
                .then(r => r.text())
                .then(html => {
                    document.getElementById('copyModalBody').innerHTML = html;
                    copyModal.show();
                    attachFormSubmit('#createCopyForm', '@Url.Action("Create", "BookCopies")');
                });
        }

        // ── Open Generate (Add Multiple Copies) ───────────────────────────────

        function openGenerateModal() {
            fetch('@Url.Action("GetGenerateForm", "BookCopies")' + '?bookId=' + bookId)
                .then(r => r.text())
                .then(html => {
                    document.getElementById('copyModalBody').innerHTML = html;
                    // Generate modal cần dialog rộng hơn
                    document.querySelector('#copyModal .modal-dialog').classList.remove('modal-sm');
                    copyModal.show();
                    attachFormSubmit('#generateCopyForm', '@Url.Action("Generate", "BookCopies")');
                    attachGeneratePreview();
                });
        }

        // ── Open Edit ─────────────────────────────────────────────────────────

        function openEditModal(id) {
            fetch('@Url.Action("GetEditForm", "BookCopies")/' + id)
                .then(r => r.text())
                .then(html => {
                    document.getElementById('copyModalBody').innerHTML = html;
                    copyModal.show();
                    attachFormSubmit('#editCopyForm', '@Url.Action("Edit", "BookCopies")');
                });
        }

        // ── Toggle Hide ────────────────────────────────────────────────────────

        function toggleHide(id) {
            fetch('@Url.Action("ToggleHide", "BookCopies")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: 'id=' + id + '&__RequestVerificationToken=' + getAntiForgeryToken()
            })
            .then(r => r.json())
            .then(result => {
                showToast(result.message, result.success);
                if (result.success) setTimeout(() => location.reload(), 1000);
            });
        }

        // ── Delete ─────────────────────────────────────────────────────────────

        function confirmDelete(id, barcode) {
            pendingDeleteId = id;
            document.getElementById('deleteBarcodeLabel').textContent = barcode;
            deleteModal.show();
        }

        document.getElementById('confirmDeleteBtn').addEventListener('click', function () {
            if (!pendingDeleteId) return;
            fetch('@Url.Action("Delete", "BookCopies")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: 'id=' + pendingDeleteId + '&__RequestVerificationToken=' + getAntiForgeryToken()
            })
            .then(r => r.json())
            .then(result => {
                deleteModal.hide();
                showToast(result.message, result.success);
                if (result.success) setTimeout(() => location.reload(), 1000);
            });
        });

        // ── Generic form submit ────────────────────────────────────────────────

        function attachFormSubmit(formSelector, actionUrl) {
            const form = document.querySelector(formSelector);
            if (!form) return;
            form.addEventListener('submit', function (e) {
                e.preventDefault();
                const data = new FormData(form);
                fetch(actionUrl, { method: 'POST', body: data })
                    .then(r => {
                        const ct = r.headers.get('Content-Type') || '';
                        if (ct.includes('application/json')) {
                            return r.json().then(result => {
                                if (result.success) {
                                    copyModal.hide();
                                    showToast(result.message, true);
                                    setTimeout(() => location.reload(), 1200);
                                } else {
                                    showToast(result.message, false);
                                }
                            });
                        } else {
                            return r.text().then(html => {
                                document.getElementById('copyModalBody').innerHTML = html;
                                attachFormSubmit(formSelector, actionUrl);
                                if (formSelector === '#generateCopyForm') attachGeneratePreview();
                            });
                        }
                    });
            });
        }

        // ── Live preview of generated barcodes ────────────────────────────────

        function attachGeneratePreview() {
            const form = document.querySelector('#generateCopyForm');
            if (!form) return;
            const previewEl = document.getElementById('barcodePreview');
            function updatePreview() {
                const prefix = form.querySelector('[name="BarcodePrefix"]')?.value || '';
                const startRaw = form.querySelector('[name="StartNumber"]')?.value || '0001';
                const qty = parseInt(form.querySelector('[name="Quantity"]')?.value) || 0;
                const padWidth = startRaw.length;
                const start = parseInt(startRaw) || 1;
                if (!previewEl) return;
                if (qty <= 0 || qty > 100) { previewEl.textContent = ''; return; }
                const samples = Array.from({ length: Math.min(qty, 5) }, (_, i) =>
                    `${prefix}${String(start + i).padStart(padWidth, '0')}`
                );
                const more = qty > 5 ? ` ... (+${qty - 5} nữa)` : '';
                previewEl.textContent = samples.join('  ') + more;
            }
            form.querySelectorAll('[name="BarcodePrefix"],[name="StartNumber"],[name="Quantity"]')
                .forEach(el => el.addEventListener('input', updatePreview));
            updatePreview();
        }

        function getAntiForgeryToken() {
            const el = document.querySelector('input[name="__RequestVerificationToken"]');
            return el ? el.value : '';
        }
    </script>
}
