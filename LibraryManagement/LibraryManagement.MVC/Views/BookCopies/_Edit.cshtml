@model LibraryManagement.MVC.ViewModels.BookCopies.UpdateBookCopyViewModel

<form id="editCopyForm" method="post" asp-action="Edit" asp-controller="BookCopies" novalidate>
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="CopyId" />
    <input type="hidden" asp-for="BookId" />

    <div class="modal-header border-0 pb-0">
        <div>
            <h5 class="modal-title fw-bold">
                <i class="bi bi-pencil-square text-warning me-2"></i>Chỉnh sửa bản sao
            </h5>
            <p class="text-muted small mb-0">
                <i class="bi bi-book me-1"></i>@Model.BookTitle
            </p>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
    </div>

    <div class="modal-body">
        <div class="mb-3">
            <label asp-for="Barcode" class="form-label fw-semibold">
                <i class="bi bi-qr-code me-1 text-muted"></i>Barcode <span class="text-danger">*</span>
            </label>
            <input asp-for="Barcode" class="form-control font-monospace" placeholder="VD: HP0001" autofocus />
            <span asp-validation-for="Barcode" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ReplacementPrice" class="form-label fw-semibold">
                <i class="bi bi-cash-coin me-1 text-muted"></i>Giá thay thế <span class="text-danger">*</span>
            </label>
            <div class="input-group">
                <input asp-for="ReplacementPrice" type="number" min="1" step="0.01" class="form-control" />
                <span class="input-group-text">VND</span>
            </div>
            <span asp-validation-for="ReplacementPrice" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Status" class="form-label fw-semibold">
                <i class="bi bi-circle-fill me-1 text-muted" style="font-size:.5rem;"></i>Trạng thái <span class="text-danger">*</span>
            </label>
            <select asp-for="Status" class="form-select">
                <option value="Available">Available</option>
                <option value="Borrowed">Borrowed</option>
                <option value="Lost">Lost</option>
                <option value="Damaged">Damaged</option>
                <option value="Hidden">Hidden</option>
            </select>
            <span asp-validation-for="Status" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ShelfSlotId" class="form-label fw-semibold">
                <i class="bi bi-geo-alt me-1 text-muted"></i>Vị trí lưu trữ
            </label>
            <select asp-for="ShelfSlotId" class="form-select">
                <option value="">-- Chưa xếp vào kệ --</option>
                @if (ViewBag.Slots != null)
                {
                    foreach (var slot in (List<LibraryManagement.MVC.ViewModels.Shelf.ShelfSlotViewModel>)ViewBag.Slots)
                    {
                        <option value="@slot.SlotId">@slot.DisplayName</option>
                    }
                }
            </select>
            <span asp-validation-for="ShelfSlotId" class="text-danger small"></span>
        </div>
    </div>

    <div class="modal-footer border-0 pt-0">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
            <i class="bi bi-x-lg me-1"></i>Hủy
        </button>
        <button type="submit" class="btn btn-warning">
            <i class="bi bi-save me-1"></i>Lưu thay đổi
        </button>
    </div>
</form>
