@model LibraryManagement.MVC.ViewModels.BookCopies.GenerateBookCopiesViewModel

<form id="generateCopyForm" method="post" asp-action="Generate" asp-controller="BookCopies" novalidate>
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="BookId" />

    <div class="modal-header border-0 pb-0">
        <div>
            <h5 class="modal-title fw-bold">
                <i class="bi bi-layers text-primary me-2"></i>Tạo nhiều bản sao
            </h5>
            <p class="text-muted small mb-0">
                <i class="bi bi-book me-1"></i>@Model.BookTitle
            </p>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
    </div>

    <div class="modal-body">
        <div class="alert alert-info border-0 py-2 px-3 small mb-4" role="alert">
            <i class="bi bi-info-circle me-1"></i>
            Barcode sẽ được tự động tạo theo mẫu:
            <span class="font-monospace fw-semibold">[Tiền tố][Số thứ tự]</span>
        </div>

        <div class="row g-3">
            <div class="col-md-4">
                <label asp-for="Quantity" class="form-label fw-semibold">
                    <i class="bi bi-hash me-1 text-muted"></i>Số lượng <span class="text-danger">*</span>
                </label>
                <input asp-for="Quantity" type="number" class="form-control" min="1" max="100" />
                <span asp-validation-for="Quantity" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="BarcodePrefix" class="form-label fw-semibold">
                    <i class="bi bi-fonts me-1 text-muted"></i>Tiền tố Barcode <span class="text-danger">*</span>
                </label>
                <input asp-for="BarcodePrefix" class="form-control font-monospace text-uppercase"
                       placeholder="VD: HP" maxlength="20" />
                <span asp-validation-for="BarcodePrefix" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="StartNumber" class="form-label fw-semibold">
                    <i class="bi bi-sort-numeric-down me-1 text-muted"></i>Số bắt đầu <span class="text-danger">*</span>
                </label>
                <input asp-for="StartNumber" class="form-control font-monospace"
                       placeholder="VD: 0001" maxlength="10" />
                <span asp-validation-for="StartNumber" class="text-danger small"></span>
            </div>
        </div>

        <div class="mt-3">
            <label asp-for="ReplacementPrice" class="form-label fw-semibold">
                <i class="bi bi-cash-coin me-1 text-muted"></i>Giá thay thế cho mỗi bản sao <span class="text-danger">*</span>
            </label>
            <div class="input-group">
                <input asp-for="ReplacementPrice" type="number" min="1" step="0.01" class="form-control" />
                <span class="input-group-text">VND</span>
            </div>
            <span asp-validation-for="ReplacementPrice" class="text-danger small"></span>
        </div>

        <div class="row g-3 mt-0">
            <div class="col-md-8">
                <label asp-for="ShelfSlotId" class="form-label fw-semibold">
                    <i class="bi bi-geo-alt me-1 text-muted"></i>Vị trí lưu trữ
                </label>
                <select asp-for="ShelfSlotId" class="form-select">
                    <option value="">-- Chưa xếp vào kệ --</option>
                    @if (ViewBag.Slots != null)
                    {
                        foreach (var slot in (List<LibraryManagement.MVC.ViewModels.Shelf.ShelfSlotViewModel>)ViewBag.Slots)
                        {
                            <option value="@slot.SlotId">@slot.DisplayName</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label asp-for="Status" class="form-label fw-semibold">
                    <i class="bi bi-circle-fill me-1 text-muted" style="font-size:.5rem;"></i>Trạng thái
                </label>
                <select asp-for="Status" class="form-select">
                    <option value="Available">Available</option>
                    <option value="Borrowed">Borrowed</option>
                    <option value="Damaged">Damaged</option>
                </select>
            </div>
        </div>

        @* Live preview *@
        <div class="mt-4 p-3 bg-light rounded-3 border">
            <div class="small text-muted fw-semibold mb-2">
                <i class="bi bi-eye me-1"></i>Xem trước barcode sẽ được tạo:
            </div>
            <div id="barcodePreview" class="font-monospace text-primary fw-semibold small" style="min-height:1.4em;">
                — Nhập thông tin để xem trước —
            </div>
        </div>
    </div>

    <div class="modal-footer border-0 pt-0">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
            <i class="bi bi-x-lg me-1"></i>Hủy
        </button>
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-layers me-1"></i>Tạo bản sao
        </button>
    </div>
</form>
