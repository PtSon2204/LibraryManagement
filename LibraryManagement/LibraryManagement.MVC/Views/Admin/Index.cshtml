@model LibraryManagement.Business.DTOs.DashboardStatsDto
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Dashboard Thống kê";
}

<div class="row g-4 mb-4">
    <!-- Card 1: Books -->
    <div class="col-xl-3 col-md-6">
        <div class="card border-0 shadow-sm rounded-4 p-4" style="background: white; border-left: 5px solid var(--brand-green) !important;">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-muted mb-1 text-uppercase" style="font-size: 0.75rem; letter-spacing: 1px;">Tổng số sách</h6>
                    <h3 class="fw-bold mb-0 text-dark">@Model?.TotalBooks</h3>
                    <small class="text-muted">@Model?.TotalBookCopies bản sao</small>
                </div>
                <div class="bg-success-subtle text-success p-3 rounded-3">
                    <i class="bi bi-book fs-3"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Card 2: Members -->
    <div class="col-xl-3 col-md-6">
        <div class="card border-0 shadow-sm rounded-4 p-4" style="background: white; border-left: 5px solid #3b82f6 !important;">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-muted mb-1 text-uppercase" style="font-size: 0.75rem; letter-spacing: 1px;">Độc giả (Thành viên)</h6>
                    <h3 class="fw-bold mb-0 text-dark">@Model?.TotalMembers</h3>
                    <small class="text-muted">Tài khoản hoạt động</small>
                </div>
                <div class="bg-primary-subtle text-primary p-3 rounded-3">
                    <i class="bi bi-people fs-3"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Card 3: Loans -->
    <div class="col-xl-3 col-md-6">
        <div class="card border-0 shadow-sm rounded-4 p-4" style="background: white; border-left: 5px solid #f59e0b !important;">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-muted mb-1 text-uppercase" style="font-size: 0.75rem; letter-spacing: 1px;">Đang mượn</h6>
                    <h3 class="fw-bold mb-0 text-dark">@Model?.ActiveLoans</h3>
                    <small class="text-danger fw-semibold">@Model?.OverdueLoans quá hạn</small>
                </div>
                <div class="bg-warning-subtle text-warning p-3 rounded-3">
                    <i class="bi bi-journal-arrow-up fs-3"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Card 4: Fines -->
    <div class="col-xl-3 col-md-6">
        <div class="card border-0 shadow-sm rounded-4 p-4" style="background: white; border-left: 5px solid #ef4444 !important;">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-muted mb-1 text-uppercase" style="font-size: 0.75rem; letter-spacing: 1px;">Tiền phạt thu được</h6>
                    <h3 class="fw-bold mb-0 text-dark">@Model?.TotalFinesAmount.ToString("N0")đ</h3>
                    <small class="text-warning fw-semibold">Chờ thu: @Model?.PendingFinesAmount.ToString("N0")đ</small>
                </div>
                <div class="bg-danger-subtle text-danger p-3 rounded-3">
                    <i class="bi bi-cash-stack fs-3"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Chart: Loans Monthly -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 p-4" style="background: white;">
            <h5 class="fw-bold mb-4 text-dark">Biểu đồ mượn sách năm @DateTime.Now.Year</h5>
            <div style="height: 320px; position: relative;">
                <canvas id="loansChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Recent Activities -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 p-4" style="background: white; height: 100%;">
            <h5 class="fw-bold mb-4 text-dark">Mượn sách gần đây</h5>
            <div class="timeline d-flex flex-column gap-3 overflow-auto" style="max-height: 320px;">
                @if (Model?.RecentLoans == null || !Model.RecentLoans.Any())
                {
                    <div class="text-center py-4 text-muted">Không có dữ liệu mượn sách gần đây</div>
                }
                else
                {
                    @foreach (var loan in Model.RecentLoans)
                    {
                        <div class="d-flex gap-3 align-items-start border-bottom pb-3">
                            <div class="bg-success-subtle text-success p-2 rounded-circle">
                                <i class="bi bi-arrow-right-short fs-4"></i>
                            </div>
                            <div style="flex-grow: 1;">
                                <span class="d-block fw-semibold text-dark" style="font-size: 0.9rem;">@loan.BorrowerName</span>
                                <small class="text-muted d-block" style="font-size: 0.8rem;">Đã mượn: <strong>@loan.BookTitle</strong></small>
                                <small class="text-muted" style="font-size: 0.75rem;"><i class="bi bi-clock me-1"></i>@loan.BorrowedAt.ToString("dd/MM/yyyy HH:mm")</small>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const ctx = document.getElementById('loansChart').getContext('2d');
            
            const monthLabels = @Html.Raw(Json.Serialize(Model?.MonthlyLoanStats.Select(s => s.MonthName) ?? new List<string>()));
            const loanCounts = @Html.Raw(Json.Serialize(Model?.MonthlyLoanStats.Select(s => s.LoanCount) ?? new List<int>()));

            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: monthLabels,
                    datasets: [{
                        label: 'Lượt mượn sách',
                        data: loanCounts,
                        backgroundColor: 'rgba(16, 185, 129, 0.85)',
                        borderColor: 'rgb(16, 185, 129)',
                        borderWidth: 1,
                        borderRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: false
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: {
                                color: '#f1f5f9'
                            },
                            ticks: {
                                stepSize: 1
                            }
                        },
                        x: {
                            grid: {
                                display: false
                            }
                        }
                    }
                }
            });
        });
    </script>
}
