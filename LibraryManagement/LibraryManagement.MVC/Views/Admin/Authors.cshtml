@model IEnumerable<LibraryManagement.Business.DTOs.AuthorDto>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý tác giả";
    var search = ViewData["Search"] as string;
}

<div class="card border-0 shadow-sm rounded-4 p-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <!-- Search Form -->
        <form method="get" class="d-flex gap-2" style="max-width: 400px; flex-grow: 1;">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" name="search" value="@search" class="form-control border-start-0" placeholder="Tìm kiếm tên tác giả..." />
            </div>
            <button type="submit" class="btn btn-outline-brand">Tìm</button>
            @if (!string.IsNullOrEmpty(search))
            {
                <a href="/Admin/Authors" class="btn btn-outline-secondary">Xóa</a>
            }
        </form>

        <!-- Add Button -->
        <button type="button" class="btn btn-brand" data-bs-toggle="modal" data-bs-target="#addAuthorModal">
            <i class="bi bi-plus-lg me-1"></i> Thêm tác giả
        </button>
    </div>

    <!-- Table -->
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Tên tác giả</th>
                    <th>Tiểu sử / Giới thiệu</th>
                    <th class="text-end" style="width: 200px;">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="3" class="text-center py-5 text-muted">Không tìm thấy tác giả nào.</td>
                    </tr>
                }
                else
                {
                    @foreach (var author in Model)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold text-dark">@author.FullName</div>
                            </td>
                            <td>
                                <div class="text-muted text-truncate" style="max-width: 500px;" title="@author.Biography">
                                    @(string.IsNullOrEmpty(author.Biography) ? "Chưa có tiểu sử" : author.Biography)
                                </div>
                            </td>
                            <td class="text-end">
                                <button type="button" class="btn btn-sm btn-outline-primary me-2 edit-btn" 
                                        data-id="@author.AuthorId" 
                                        data-name="@author.FullName" 
                                        data-bio="@author.Biography" 
                                        data-bs-toggle="modal" data-bs-target="#editAuthorModal">
                                    <i class="bi bi-pencil-fill me-1"></i> Sửa
                                </button>

                                <form asp-action="DeleteAuthor" asp-route-id="@author.AuthorId" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Bạn có chắc chắn muốn xóa tác giả này?')">
                                        <i class="bi bi-trash-fill me-1"></i> Xóa
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Add Author Modal -->
<div class="modal fade" id="addAuthorModal" tabindex="-1" aria-labelledby="addAuthorModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold text-dark" id="addAuthorModalLabel">Thêm tác giả mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="CreateAuthor" method="post">
                <div class="modal-body py-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tên tác giả</label>
                        <input type="text" name="FullName" class="form-control rounded-3" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tiểu sử</label>
                        <textarea name="Biography" rows="4" class="form-control rounded-3" placeholder="Giới thiệu ngắn về tác giả..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-top-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary px-4 py-2" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-brand px-4 py-2">Thêm</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Author Modal -->
<div class="modal fade" id="editAuthorModal" tabindex="-1" aria-labelledby="editAuthorModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold text-dark" id="editAuthorModalLabel">Cập nhật thông tin tác giả</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="editAuthorForm" method="post" asp-action="EditAuthor">
                <div class="modal-body py-4">
                    <input type="hidden" id="editAuthorId" name="id" />
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tên tác giả</label>
                        <input type="text" id="editFullName" name="FullName" class="form-control rounded-3" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tiểu sử</label>
                        <textarea id="editBiography" name="Biography" rows="4" class="form-control rounded-3"></textarea>
                    </div>
                </div>
                <div class="modal-footer border-top-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary px-4 py-2" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-brand px-4 py-2">Lưu thay đổi</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const editBtns = document.querySelectorAll(".edit-btn");
            const editForm = document.getElementById("editAuthorForm");
            const editIdInput = document.getElementById("editAuthorId");
            const editNameInput = document.getElementById("editFullName");
            const editBioInput = document.getElementById("editBiography");

            editBtns.forEach(btn => {
                btn.addEventListener("click", function () {
                    const id = this.getAttribute("data-id");
                    const name = this.getAttribute("data-name");
                    const bio = this.getAttribute("data-bio");

                    editForm.action = `/Admin/EditAuthor/${id}`;
                    editIdInput.value = id;
                    editNameInput.value = name;
                    editBioInput.value = bio || "";
                });
            });
        });
    </script>
}
