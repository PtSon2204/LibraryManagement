@model LibraryManagement.MVC.ViewModels.Shelf.BookshelfTreeDto
@{
    ViewData["Title"] = "Chi tiết Giá Sách: " + Model.Name;
    Layout = User.IsInRole("Admin") ? "~/Views/Shared/_AdminLayout.cshtml" : "~/Views/Shared/_LibrarianLayout.cshtml";
}

<style>
    .shelf-hero {
        background: linear-gradient(135deg, #1e3a5f 0%, #0d213b 100%);
        border-radius: 16px;
        padding: 28px 32px;
        color: white;
        margin-bottom: 28px;
    }
    .rack-card {
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.02);
        margin-bottom: 20px;
        background: #fff;
    }
    .rack-header {
        background: #f8fafc;
        padding: 16px 20px;
        border-bottom: 1px solid #e2e8f0;
        border-radius: 12px 12px 0 0;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .slot-box {
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        padding: 12px;
        background: #f8fafc;
        height: 100%;
        display: flex;
        flex-direction: column;
    }
    .slot-code {
        font-weight: 700;
        color: #1e293b;
        font-size: 1.1rem;
    }
    .occupancy-bar {
        height: 6px;
        background-color: #e2e8f0;
        border-radius: 3px;
        overflow: hidden;
        margin-top: 8px;
        margin-bottom: 8px;
    }
    .occupancy-fill {
        height: 100%;
        border-radius: 3px;
        transition: width 0.3s ease;
    }
</style>

<div class="mb-3">
    <a href="/Shelf/Index" class="text-decoration-none text-muted">
        <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
    </a>
</div>

<div class="shelf-hero">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <div class="d-flex align-items-center gap-3 mb-2">
                <span class="badge bg-light text-dark fs-6">Mã: @Model.ShelfCode</span>
                <h3 class="fw-bold mb-0">@Model.Name</h3>
            </div>
            <p class="mb-0 opacity-75">
                @(string.IsNullOrEmpty(Model.Description) ? "Không có mô tả" : Model.Description)
            </p>
            <div class="mt-2 d-flex flex-wrap gap-1">
                @foreach(var cat in Model.Categories)
                {
                    <span class="badge bg-primary bg-opacity-25 border border-primary text-white">@cat.CategoryName</span>
                }
            </div>
        </div>
        @if (User.IsInRole("Admin"))
        {
            <button class="btn btn-light fw-semibold px-4" onclick="openShelfModal()">
                <i class="bi bi-plus-lg me-1"></i> Thêm tầng kệ (Rack)
            </button>
        }
    </div>
</div>

@if (!Model.Shelves.Any())
{
    <div class="text-center p-5 bg-white rounded-4 shadow-sm text-muted">
        <i class="bi bi-bookshelf" style="font-size: 3rem; opacity: 0.3;"></i>
        <p class="mt-3 fw-medium">Giá sách này chưa có tầng kệ nào.</p>
    </div>
}
else
{
    foreach (var rack in Model.Shelves.OrderBy(r => r.ShelfNumber))
    {
        <div class="rack-card">
            <div class="rack-header">
                <div>
                    <h5 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-layers text-primary me-2"></i>Kệ số @rack.ShelfNumber: @rack.Name
                    </h5>
                </div>
                @if (User.IsInRole("Admin"))
                {
                    <div class="d-flex gap-2">
                        <button class="btn btn-sm btn-outline-primary" onclick="openSlotModal('@rack.ShelfId')">
                            <i class="bi bi-plus"></i> Thêm Slot
                        </button>
                        <button class="btn btn-sm btn-outline-secondary" onclick="openEditShelfModal('@rack.ShelfId', @rack.ShelfNumber, '@rack.Name')">
                            <i class="bi bi-pencil"></i> Sửa
                        </button>
                        <button class="btn btn-sm btn-outline-danger" onclick="deleteShelf('@rack.ShelfId')">
                            <i class="bi bi-trash"></i> Xóa
                        </button>
                    </div>
                }
            </div>
            <div class="card-body bg-white p-4" style="border-radius: 0 0 12px 12px;">
                @if (!rack.Slots.Any())
                {
                    <p class="text-muted small mb-0">Chưa có vị trí chứa (Slot) nào trên kệ này.</p>
                }
                else
                {
                    <div class="row g-3">
                        @foreach (var slot in rack.Slots.OrderBy(s => s.SlotCode))
                        {
                            var color = slot.OccupancyRate >= 90 ? "bg-danger" : (slot.OccupancyRate >= 60 ? "bg-warning" : "bg-success");
                            <div class="col-6 col-md-4 col-lg-3">
                                <div class="slot-box">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div class="slot-code">@slot.SlotCode</div>
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <div class="dropdown">
                                                <button class="btn btn-sm btn-link text-muted p-0" data-bs-toggle="dropdown">
                                                    <i class="bi bi-three-dots-vertical"></i>
                                                </button>
                                                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                                    <li><a class="dropdown-item" href="#" onclick="openEditSlotModal('@slot.SlotId', '@rack.ShelfId', '@slot.SlotCode', @slot.Capacity, '')"><i class="bi bi-pencil me-2"></i>Sửa Slot</a></li>
                                                    <li><hr class="dropdown-divider"></li>
                                                    <li><a class="dropdown-item text-danger" href="#" onclick="deleteSlot('@slot.SlotId')"><i class="bi bi-trash me-2"></i>Xóa Slot</a></li>
                                                </ul>
                                            </div>
                                        }
                                    </div>
                                    
                                    <div class="mt-auto pt-2">
                                        <div class="d-flex justify-content-between text-muted small">
                                            <span>@slot.CurrentQuantity / @slot.Capacity cuốn</span>
                                            <span>@slot.OccupancyRate%</span>
                                        </div>
                                        <div class="occupancy-bar">
                                            <div class="occupancy-fill @color" style="width: @slot.OccupancyRate%"></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }
}

<!-- ════════════════ MODALS ════════════════ -->

<!-- Modal: Kệ (Shelf) -->
<div class="modal fade" id="modalShelf" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-primary" id="modalShelfTitle">Thêm tầng kệ</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="formShelf">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ShelfId" id="ShelfId" />
                <input type="hidden" name="BookshelfId" value="@Model.BookshelfId" />
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-medium">Số tầng kệ (Shelf Number) <span class="text-danger">*</span></label>
                        <input type="number" name="ShelfNumber" id="ShelfNumber" class="form-control" min="1" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-medium">Tên kệ <span class="text-danger">*</span></label>
                        <input type="text" name="Name" id="ShelfName" class="form-control" placeholder="VD: Kệ trên cùng" required />
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary px-4">Lưu kệ</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Slot -->
<div class="modal fade" id="modalSlot" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-success" id="modalSlotTitle">Thêm vị trí chứa (Slot)</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="formSlot">
                @Html.AntiForgeryToken()
                <input type="hidden" name="SlotId" id="SlotId" />
                <input type="hidden" name="ShelfId" id="SlotShelfId" />
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-medium">Mã Slot <span class="text-danger">*</span></label>
                        <input type="text" name="SlotCode" id="SlotCode" class="form-control" placeholder="VD: SE-1-A" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-medium">Sức chứa (số sách) <span class="text-danger">*</span></label>
                        <input type="number" name="Capacity" id="SlotCapacity" class="form-control" value="10" min="1" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-medium">Mô tả</label>
                        <textarea name="Description" id="SlotDescription" class="form-control" rows="2"></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-success px-4 text-white">Lưu Slot</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Toast -->
<div class="position-fixed bottom-0 end-0 p-3" style="z-index:9999">
    <div id="actionToast" class="toast align-items-center border-0" role="alert" aria-live="assertive">
        <div class="d-flex">
            <div class="toast-body fw-medium" id="toastMsg"></div>
            <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

@section Scripts {
<script>
    var mShelf = new bootstrap.Modal(document.getElementById('modalShelf'));
    var mSlot  = new bootstrap.Modal(document.getElementById('modalSlot'));
    var tstEl  = document.getElementById('actionToast');
    var tst    = new bootstrap.Toast(tstEl, { delay: 3500 });
    var shelfActionUrl = '';
    var slotActionUrl = '';

    function showToast(msg, ok) {
        tstEl.classList.remove('bg-success', 'bg-danger', 'text-white');
        tstEl.classList.add(ok ? 'bg-success' : 'bg-danger', 'text-white');
        document.getElementById('toastMsg').textContent = msg;
        tst.show();
    }

    // ── Shelf (Kệ) ──
    function openShelfModal() {
        document.getElementById('modalShelfTitle').textContent = 'Thêm tầng kệ';
        document.getElementById('formShelf').reset();
        document.getElementById('ShelfId').value = '00000000-0000-0000-0000-000000000000';
        shelfActionUrl = '@Url.Action("CreateShelf", "Shelf")';
        mShelf.show();
    }
    function openEditShelfModal(id, num, name) {
        document.getElementById('modalShelfTitle').textContent = 'Sửa tầng kệ';
        document.getElementById('ShelfId').value = id;
        document.getElementById('ShelfNumber').value = num;
        document.getElementById('ShelfName').value = name;
        shelfActionUrl = '@Url.Action("EditShelf", "Shelf")';
        mShelf.show();
    }
    function deleteShelf(id) {
        if (!confirm('Bạn có chắc muốn xóa tầng kệ này? Tất cả Slot bên trong sẽ bị xóa theo!')) return;
        postDelete('@Url.Action("DeleteShelf", "Shelf")?id=' + id);
    }

    document.getElementById('formShelf').addEventListener('submit', async e => {
        e.preventDefault();
        var data = new FormData(e.target);
        var res = await fetch(shelfActionUrl, { method: 'POST', body: data });
        var json = await res.json();
        mShelf.hide();
        showToast(json.message, json.success);
        if (json.success) setTimeout(() => location.reload(), 1200);
    });

    // ── Slot ──
    function openSlotModal(shelfId) {
        document.getElementById('modalSlotTitle').textContent = 'Thêm Slot';
        document.getElementById('formSlot').reset();
        document.getElementById('SlotId').value = '00000000-0000-0000-0000-000000000000';
        document.getElementById('SlotShelfId').value = shelfId;
        slotActionUrl = '@Url.Action("CreateSlot", "Shelf")';
        mSlot.show();
    }
    function openEditSlotModal(slotId, shelfId, code, cap, desc) {
        document.getElementById('modalSlotTitle').textContent = 'Sửa Slot';
        document.getElementById('SlotId').value = slotId;
        document.getElementById('SlotShelfId').value = shelfId;
        document.getElementById('SlotCode').value = code;
        document.getElementById('SlotCapacity').value = cap;
        document.getElementById('SlotDescription').value = desc || '';
        slotActionUrl = '@Url.Action("EditSlot", "Shelf")';
        mSlot.show();
    }
    function deleteSlot(id) {
        if (!confirm('Bạn có chắc muốn xóa Slot này?')) return;
        postDelete('@Url.Action("DeleteSlot", "Shelf")?id=' + id);
    }

    document.getElementById('formSlot').addEventListener('submit', async e => {
        e.preventDefault();
        var data = new FormData(e.target);
        var res = await fetch(slotActionUrl, { method: 'POST', body: data });
        var json = await res.json();
        mSlot.hide();
        showToast(json.message, json.success);
        if (json.success) setTimeout(() => location.reload(), 1200);
    });

    async function postDelete(url) {
        var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        var res = await fetch(url, { method: 'POST', headers: { 'RequestVerificationToken': token }});
        var json = await res.json();
        showToast(json.message, json.success);
        if (json.success) setTimeout(() => location.reload(), 1200);
    }
</script>
}
