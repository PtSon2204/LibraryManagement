@model LibraryManagement.MVC.ViewModels.Room.RoomListViewModel

@{
    ViewData["Title"] = "Quản lý phòng";
    Layout = User.IsInRole("Admin") ? "~/Views/Shared/_AdminLayout.cshtml" : "~/Views/Shared/_LibrarianLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-1 fw-bold">Danh sách phòng học/đọc</h4>
        <small class="text-muted">Tổng cộng @Model.TotalRecords phòng</small>
    </div>
    @if (User.IsInRole("Admin"))
    {
        <button class="btn btn-primary" onclick="openCreateModal()">
            <i class="bi bi-plus-lg me-1"></i> Thêm phòng mới
        </button>
    }
</div>

<!-- Search & Filter -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-6 col-lg-5">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0">
                        <i class="bi bi-search text-muted"></i>
                    </span>
                    <input type="text"
                           name="search"
                           class="form-control border-start-0 ps-0"
                           placeholder="Tìm theo tên phòng, mô tả..."
                           value="@Model.Search" />
                </div>
            </div>
            
            <div class="col-md-4 col-lg-3">
                <select name="status" class="form-select">
                    <option value="">-- Tất cả trạng thái --</option>
                    @if (Model.Status == "Available")
                    {
                        <option value="Available" selected>Có sẵn (Available)</option>
                    }
                    else
                    {
                        <option value="Available">Có sẵn (Available)</option>
                    }

                    @if (Model.Status == "Occupied")
                    {
                        <option value="Occupied" selected>Đang sử dụng (Occupied)</option>
                    }
                    else
                    {
                        <option value="Occupied">Đang sử dụng (Occupied)</option>
                    }

                    @if (Model.Status == "Maintenance")
                    {
                        <option value="Maintenance" selected>Đang bảo trì (Maintenance)</option>
                    }
                    else
                    {
                        <option value="Maintenance">Đang bảo trì (Maintenance)</option>
                    }
                </select>
            </div>

            <input type="hidden" name="pageSize" value="@Model.PageSize" />
            
            <div class="col-md-2 col-lg-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary px-3 flex-grow-1">
                    <i class="bi bi-funnel me-1"></i> Lọc
                </button>
                @if (!string.IsNullOrWhiteSpace(Model.Search) || !string.IsNullOrWhiteSpace(Model.Status))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary px-3">
                        <i class="bi bi-x-lg"></i> Xóa lọc
                    </a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Table -->
<div class="card border-0 shadow-sm rounded-3">
    <div class="card-body p-0">
        @if (Model.Data.Count == 0)
        {
            <div class="text-center py-5">
                <i class="bi bi-door-open fs-1 text-muted opacity-50"></i>
                <p class="text-muted mt-3">Không tìm thấy phòng nào.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4" style="width: 50px;">STT</th>
                            <th>Tên phòng</th>
                            <th>Số chỗ ngồi tối đa</th>
                            <th>Trạng thái</th>
                            <th>Mô tả</th>
                            @if (User.IsInRole("Admin"))
                            {
                                <th class="text-center pe-4" style="width: 150px;">Thao tác</th>
                            }
                            else
                            {
                                <th class="text-center pe-4" style="width: 100px;">Chi tiết</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var stt = (Model.PageNumber - 1) * Model.PageSize + 1;
                        }
                        @foreach (var item in Model.Data)
                        {
                            <tr>
                                <td class="ps-4 text-muted">@(stt++)</td>
                                <td class="fw-bold text-primary">@item.RoomName</td>
                                <td class="fw-semibold">@item.Capacity chỗ ngồi</td>
                                <td>
                                    @if (item.Status == "Available")
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1.5">Có sẵn</span>
                                    }
                                    else if (item.Status == "Occupied")
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2.5 py-1.5">Đang sử dụng</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2.5 py-1.5">Bảo trì</span>
                                    }
                                </td>
                                <td class="text-muted small text-truncate" style="max-width: 250px;">
                                    @(string.IsNullOrWhiteSpace(item.Description) ? "-" : item.Description)
                                </td>
                                <td class="text-center pe-4">
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <div class="d-flex justify-content-center gap-1">
                                            <a asp-action="Details" asp-route-id="@item.RoomId"
                                               class="btn btn-sm btn-outline-primary" title="Chi tiết">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <button class="btn btn-sm btn-outline-warning" title="Chỉnh sửa"
                                                    onclick="openEditModal('@item.RoomId')">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger" title="Xóa"
                                                    onclick="deleteRoom('@item.RoomId')">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    }
                                    else
                                    {
                                        <a asp-action="Details" asp-route-id="@item.RoomId"
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-eye"></i> Chi tiết
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            @if (Model.TotalPages > 1)
            {
                <div class="d-flex justify-content-between align-items-center px-4 py-3 border-top">
                    <small class="text-muted">
                        Trang @Model.PageNumber / @Model.TotalPages
                        &nbsp;•&nbsp; @Model.TotalRecords phòng
                    </small>
                    <nav>
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-search="@Model.Search"
                                   asp-route-status="@Model.Status"
                                   asp-route-pageNumber="@(Model.PageNumber - 1)"
                                   asp-route-pageSize="@Model.PageSize">
                                    <i class="bi bi-chevron-left"></i>
                                </a>
                            </li>
                            @for (int i = Math.Max(1, Model.PageNumber - 2); i <= Math.Min(Model.TotalPages, Model.PageNumber + 2); i++)
                            {
                                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-route-search="@Model.Search"
                                       asp-route-status="@Model.Status"
                                       asp-route-pageNumber="@i"
                                       asp-route-pageSize="@Model.PageSize">@i</a>
                                </li>
                            }
                            <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-search="@Model.Search"
                                   asp-route-status="@Model.Status"
                                   asp-route-pageNumber="@(Model.PageNumber + 1)"
                                   asp-route-pageSize="@Model.PageSize">
                                    <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        }
    </div>
</div>

<!-- Modal dùng chung -->
<div class="modal fade" id="roomModal" tabindex="-1" aria-labelledby="roomModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-md modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div id="roomModalBody"></div>
        </div>
    </div>
</div>

<!-- Toast thông báo -->
<div class="position-fixed bottom-0 end-0 p-3" style="z-index: 2000">
    <div id="toastMsg" class="toast align-items-center border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body fw-medium" id="toastText"></div>
            <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const roomModal = new bootstrap.Modal(document.getElementById('roomModal'));
        const toast = new bootstrap.Toast(document.getElementById('toastMsg'), { delay: 3000 });

        function showToast(message, isSuccess) {
            const toastEl = document.getElementById('toastMsg');
            toastEl.classList.remove('bg-success', 'bg-danger', 'text-white');
            toastEl.classList.add(isSuccess ? 'bg-success' : 'bg-danger', 'text-white');
            document.getElementById('toastText').textContent = message;
            toast.show();
        }

        function openCreateModal() {
            fetch('@Url.Action("GetCreateForm", "Room")')
                .then(r => r.text())
                .then(html => {
                    document.getElementById('roomModalBody').innerHTML = html;
                    roomModal.show();
                    attachFormSubmit('#createRoomForm', '@Url.Action("Create", "Room")');
                });
        }

        function openEditModal(id) {
            fetch('@Url.Action("GetEditForm", "Room")/' + id)
                .then(r => r.text())
                .then(html => {
                    document.getElementById('roomModalBody').innerHTML = html;
                    roomModal.show();
                    attachFormSubmit('#editRoomForm', '@Url.Action("Edit", "Room")');
                });
        }

        function attachFormSubmit(formSelector, actionUrl) {
            const form = document.querySelector(formSelector);
            if (!form) return;
            form.addEventListener('submit', function (e) {
                e.preventDefault();
                const formData = new FormData(form);
                fetch(actionUrl, {
                    method: 'POST',
                    body: formData
                })
                .then(r => {
                    const contentType = r.headers.get('Content-Type') || '';
                    if (contentType.includes('application/json')) {
                        return r.json().then(result => {
                            if (result.success) {
                                roomModal.hide();
                                showToast(result.message, true);
                                setTimeout(() => location.reload(), 1200);
                            } else {
                                showToast(result.message, false);
                            }
                        });
                    } else {
                        return r.text().then(html => {
                            document.getElementById('roomModalBody').innerHTML = html;
                            // Re-attach submit handler
                            attachFormSubmit(formSelector, actionUrl);
                        });
                    }
                });
            });
        }

        function deleteRoom(id) {
            if (confirm('Bạn có chắc chắn muốn xóa phòng học/đọc này không?')) {
                fetch('@Url.Action("Delete", "Room")/' + id, {
                    method: 'POST'
                })
                .then(r => r.json())
                .then(result => {
                    showToast(result.message, result.success);
                    if (result.success) {
                        setTimeout(() => location.reload(), 1200);
                    }
                });
            }
        }
    </script>
}
