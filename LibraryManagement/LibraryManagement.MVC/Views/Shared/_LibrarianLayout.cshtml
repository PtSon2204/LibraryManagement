<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Thủ thư</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        :root {
            --sidebar-width: 260px;
        }
        body {
            background-color: #f8fafc;
        }
        .admin-sidebar {
            width: var(--sidebar-width);
            height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            background-color: #1e3a5f;
            color: #f8fafc;
            z-index: 100;
            display: flex;
            flex-direction: column;
            box-shadow: 4px 0 10px rgba(0,0,0,0.05);
        }
        .sidebar-header {
            padding: 1.5rem;
            border-bottom: 1px solid #2d5282;
        }
        .sidebar-menu {
            padding: 1.5rem 1rem;
            flex-grow: 1;
        }
        .menu-link {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.75rem 1rem;
            color: #94a3b8;
            text-decoration: none;
            border-radius: 0.5rem;
            font-weight: 500;
            transition: all 0.2s ease;
            margin-bottom: 0.5rem;
        }
        .menu-link:hover, .menu-link.active {
            color: #ffffff;
            background-color: #2d5282;
        }
        .menu-link.active {
            background-color: var(--brand-green, #2563eb);
            color: white !important;
        }
        .admin-main {
            margin-left: var(--sidebar-width);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }
        .admin-navbar {
            height: 70px;
            background: #ffffff;
            border-bottom: 1px solid #e2e8f0;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 2rem;
        }
        .admin-content {
            padding: 2rem;
            flex-grow: 1;
        }
    </style>
</head>
<body>
    <div class="admin-sidebar">
        <div class="sidebar-header d-flex align-items-center gap-2">
            <i class="bi bi-book text-info fs-3"></i>
            <div>
                <h6 class="mb-0 fw-bold">Thủ thư</h6>
                <small class="text-muted" style="font-size: 0.7rem;">Hệ thống thư viện</small>
            </div>
        </div>
        
        <div class="sidebar-menu">
            <a asp-controller="Librarian" asp-action="Index" class="menu-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Librarian" ? "active" : "")">
                <i class="bi bi-speedometer2"></i> Dashboard
            </a>
            <a asp-controller="Publisher" asp-action="Index" class="menu-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Publisher" ? "active" : "")">
                <i class="bi bi-building"></i> Quản lý nhà xuất bản
            </a>
            <a asp-controller="Book" asp-action="Index" class="menu-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Book" ? "active" : "")">
                <i class="bi bi-building"></i> Quản lý sách
            </a>
        </div>

        <div class="p-3 border-top border-secondary">

            <a asp-controller="UserProfile" asp-action="Index" class="menu-link">
                <i class="bi bi-person-circle"></i> Hồ sơ cá nhân
            </a>
            <a href="/Account/Logout" class="menu-link text-danger">
                <i class="bi bi-box-arrow-left"></i> Đăng xuất
            </a>
        </div>
    </div>

    <div class="admin-main">
        <header class="admin-navbar">
            <div class="d-flex align-items-center gap-2">
                <h5 class="mb-0 fw-semibold text-dark">@ViewData["Title"]</h5>
            </div>
            <div class="d-flex align-items-center gap-3">
                <div class="text-end d-none d-md-block">
                    <span class="d-block fw-semibold" style="font-size: 0.9rem;">@User.Identity?.Name</span>
                    <span class="badge bg-info-subtle text-info border border-info-subtle" style="font-size: 0.7rem;">Thủ thư</span>
                </div>
                <div class="bg-info rounded-circle text-white d-flex align-items-center justify-content-center" style="width: 40px; height: 40px; font-weight: 600;">
                    @User.Identity?.Name?[0].ToString().ToUpper()
                </div>
            </div>
        </header>

        <main class="admin-content">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
