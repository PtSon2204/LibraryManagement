<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Panel</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        :root {
            --sidebar-width: 260px;
        }
        body {
            background-color: #f8fafc;
        }
        .admin-sidebar {
            width: var(--sidebar-width);
            height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            background-color: #1e293b;
            color: #f8fafc;
            z-index: 100;
            display: flex;
            flex-direction: column;
            box-shadow: 4px 0 10px rgba(0,0,0,0.05);
        }
        .sidebar-header {
            padding: 1.5rem;
            border-bottom: 1px solid #334155;
        }
        .sidebar-menu {
            padding: 1.5rem 1rem;
            flex-grow: 1;
        }
        .menu-link {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.75rem 1rem;
            color: #94a3b8;
            text-decoration: none;
            border-radius: 0.5rem;
            font-weight: 500;
            transition: all 0.2s ease;
            margin-bottom: 0.5rem;
        }
        .menu-link:hover, .menu-link.active {
            color: #ffffff;
            background-color: #334155;
        }
        .menu-link.active {
            background-color: var(--brand-green);
            color: white !important;
        }
        .admin-main {
            margin-left: var(--sidebar-width);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }
        .admin-navbar {
            height: 70px;
            background: #ffffff;
            border-bottom: 1px solid #e2e8f0;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 2rem;
        }
        .admin-content {
            padding: 2rem;
            flex-grow: 1;
        }
    </style>
</head>
<body>
    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    }
    <div class="admin-sidebar">
        <div class="sidebar-header d-flex align-items-center gap-2">
            <i class="bi bi-shield-lock text-success fs-3"></i>
            <div>
                <h6 class="mb-0 fw-bold">Admin Portal</h6>
                <small class="text-muted" style="font-size: 0.7rem;">Hệ thống thư viện</small>
            </div>
        </div>
        <div class="sidebar-menu">
            <a href="/Admin" class="menu-link @(currentController == "Admin" && currentAction == "Index" ? "active" : "")">
                <i class="bi bi-speedometer2"></i> Dashboard
            </a>
            <a href="/Admin/Users" class="menu-link @(currentController == "Admin" && currentAction == "Users" ? "active" : "")">
                <i class="bi bi-people"></i> Quản lý thành viên
            </a>
            <a href="/Book/Index" class="menu-link @(currentController == "Book" ? "active" : "")">
                <i class="bi bi-book"></i> Quản lý sách
            </a>
            <a href="/Publisher/Index" class="menu-link @(currentController == "Publisher" ? "active" : "")">
                <i class="bi bi-building"></i> Quản lý nhà xuất bản
            </a>
            <a href="/Category/Index" class="menu-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Category" ? "active" : "")">
                <i class="bi bi-tags"></i> Quản lý thể loại
            </a>
            <a href="/Room/Index" class="menu-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Room" ? "active" : "")">
                <i class="bi bi-door-open"></i> Quản lý phòng
            </a>
            <a href="/Floor/Index" class="menu-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Floor" ? "active" : "")">
                <i class="bi bi-layers"></i> Quản lý tầng
            </a>
            <a href="/Shelf/Index" class="menu-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Shelf" ? "active" : "")">
                <i class="bi bi-bookshelf"></i> Quản lý giá sách
            </a>
            <a asp-controller="Author" asp-action="Index" class="menu-link @(currentController == "Author" ? "active" : "")">
                <i class="bi bi-journal-text"></i> Quản lý tác giả
            </a>
            <a asp-controller="Reports" asp-action="Index" class="menu-link @(currentController == "Reports" ? "active" : "")">
                <i class="bi bi-graph-up-arrow"></i> Báo cáo thống kê
            </a>
        </div>
        <div class="p-3 border-top border-secondary">
            <a asp-controller="Home" asp-action="Index" class="menu-link">
                <i class="bi bi-house-door"></i> Trang chủ
            </a>
            <a asp-controller="Account" asp-action="ChangePassword" class="menu-link text-warning">
                <i class="bi bi-shield-lock"></i> Đổi mật khẩu
            </a>
            <a href="/Account/Logout" class="menu-link text-danger">
                <i class="bi bi-box-arrow-left"></i> Đăng xuất
            </a>
        </div>
    </div>

    <div class="admin-main">
        <header class="admin-navbar">
            <div class="d-flex align-items-center gap-2">
                <h5 class="mb-0 fw-semibold text-dark">@ViewData["Title"]</h5>
            </div>
            <div class="d-flex align-items-center gap-3">
                <div class="text-end d-none d-md-block">
                    <span class="d-block fw-semibold" style="font-size: 0.9rem;">@User.Identity?.Name</span>
                    <span class="badge bg-success-subtle text-success border border-success-subtle" style="font-size: 0.7rem;">Administrator</span>
                </div>
                <div class="bg-success rounded-circle text-white d-flex align-items-center justify-content-center" style="width: 40px; height: 40px; font-weight: 600;">
                    @User.Identity?.Name?[0].ToString().ToUpper()
                </div>
            </div>
        </header>

        <main class="admin-content">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
