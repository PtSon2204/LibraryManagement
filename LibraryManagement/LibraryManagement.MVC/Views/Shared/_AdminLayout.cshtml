<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Panel</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        :root {
            --sidebar-width: 260px;
            --brand-green: #16a34a;
        }
        body {
            background-color: #f8fafc;
        }
        /* ===== SIDEBAR ===== */
        .admin-sidebar {
            width: var(--sidebar-width);
            height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            background-color: #1e293b;
            color: #f8fafc;
            z-index: 100;
            display: flex;
            flex-direction: column;
            box-shadow: 4px 0 10px rgba(0,0,0,0.1);
            overflow: hidden;
        }
        .sidebar-header {
            padding: 1.25rem 1.5rem;
            border-bottom: 1px solid #334155;
            flex-shrink: 0;
        }
        /* Scrollable menu area */
        .sidebar-menu {
            flex: 1 1 auto;
            overflow-y: auto;
            overflow-x: hidden;
            padding: 0.75rem 0.75rem;
            scrollbar-width: thin;
            scrollbar-color: #334155 transparent;
        }
        .sidebar-menu::-webkit-scrollbar {
            width: 4px;
        }
        .sidebar-menu::-webkit-scrollbar-track {
            background: transparent;
        }
        .sidebar-menu::-webkit-scrollbar-thumb {
            background-color: #334155;
            border-radius: 4px;
        }
        /* Menu group label */
        .menu-group-label {
            font-size: 0.65rem;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: #475569;
            padding: 0.75rem 0.5rem 0.35rem;
            margin-top: 0.25rem;
        }
        .menu-group-label:first-child {
            margin-top: 0;
        }
        /* Divider between groups */
        .menu-divider {
            border: none;
            border-top: 1px solid #334155;
            margin: 0.5rem 0.5rem;
        }
        /* Menu links */
        .menu-link {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.6rem 0.875rem;
            color: #94a3b8;
            text-decoration: none;
            border-radius: 0.5rem;
            font-weight: 500;
            font-size: 0.875rem;
            transition: all 0.2s ease;
            margin-bottom: 0.15rem;
            white-space: nowrap;
        }
        .menu-link i {
            font-size: 1rem;
            flex-shrink: 0;
        }
        .menu-link:hover {
            color: #ffffff;
            background-color: #334155;
        }
        .menu-link.active {
            background-color: var(--brand-green);
            color: white !important;
        }
        .menu-link.link-warning {
            color: #fbbf24 !important;
        }
        .menu-link.link-warning:hover {
            background-color: rgba(251,191,36,0.15);
            color: #fde68a !important;
        }
        .menu-link.link-danger {
            color: #f87171 !important;
        }
        .menu-link.link-danger:hover {
            background-color: rgba(248,113,113,0.15);
            color: #fca5a5 !important;
        }
        /* ===== MAIN CONTENT ===== */
        .admin-main {
            margin-left: var(--sidebar-width);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }
        .admin-navbar {
            height: 70px;
            background: #ffffff;
            border-bottom: 1px solid #e2e8f0;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 2rem;
        }
        .admin-content {
            padding: 2rem;
            flex-grow: 1;
        }
    </style>
</head>
<body>
    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    }
    <div class="admin-sidebar">
        <!-- Header -->
        <div class="sidebar-header d-flex align-items-center gap-2">
            <i class="bi bi-shield-lock text-success fs-3"></i>
            <div>
                <h6 class="mb-0 fw-bold">Admin Portal</h6>
                <small class="text-muted" style="font-size: 0.7rem;">Hệ thống thư viện</small>
            </div>
        </div>

        <!-- Scrollable Menu -->
        <div class="sidebar-menu">

            <!-- Nhóm: Tổng quan -->
            <div class="menu-group-label">Tổng quan</div>
            <a href="/Admin" class="menu-link @(currentController == "Admin" && currentAction == "Index" ? "active" : "")">
                <i class="bi bi-speedometer2"></i> Dashboard
            </a>

            <!-- Nhóm: Quản lý -->
            <div class="menu-group-label">Quản lý</div>
            <a href="/Admin/Users" class="menu-link @(currentController == "Admin" && currentAction == "Users" ? "active" : "")">
                <i class="bi bi-people"></i> Thành viên
            </a>
            <a href="/Book/Index" class="menu-link @(currentController == "Book" ? "active" : "")">
                <i class="bi bi-book"></i> Sách
            </a>
            <a href="/Publisher/Index" class="menu-link @(currentController == "Publisher" ? "active" : "")">
                <i class="bi bi-building"></i> Nhà xuất bản
            </a>
            <a href="/Category/Index" class="menu-link @(currentController == "Category" ? "active" : "")">
                <i class="bi bi-tags"></i> Thể loại
            </a>
            <a asp-controller="Author" asp-action="Index" class="menu-link @(currentController == "Author" ? "active" : "")">
                <i class="bi bi-journal-text"></i> Tác giả
            </a>

            <!-- Nhóm: Cơ sở vật chất -->
            <div class="menu-group-label">Cơ sở vật chất</div>
            <a href="/Room/Index" class="menu-link @(currentController == "Room" ? "active" : "")">
                <i class="bi bi-door-open"></i> Phòng
            </a>
            <a href="/SlotTemplates/Index" class="menu-link @(currentController == "SlotTemplates" ? "active" : "")">
                <i class="bi bi-clock-history"></i> Khung giờ chuẩn
            </a>
            <a href="/Floor/Index" class="menu-link @(currentController == "Floor" ? "active" : "")">
                <i class="bi bi-layers"></i> Tầng
            </a>
            <a href="/Shelf/Index" class="menu-link @(currentController == "Shelf" ? "active" : "")">
                <i class="bi bi-bookshelf"></i> Giá sách
            </a>
            <a asp-controller="FineManagement" asp-action="Index" class="menu-link @(currentController == "FineManagement" ? "active" : "")">
                <i class="bi bi-cash-stack"></i> Quản lý khoản phạt
            </a>

            <!-- Nhóm: Báo cáo -->
            <div class="menu-group-label">Báo cáo</div>
            <a asp-controller="Reports" asp-action="Index" class="menu-link @(currentController == "Reports" ? "active" : "")">
                <i class="bi bi-graph-up-arrow"></i> Báo cáo thống kê
            </a>

            <hr class="menu-divider" />

            <!-- Nhóm: Tài khoản -->
            <div class="menu-group-label">Tài khoản</div>
            <a asp-controller="Home" asp-action="Index" class="menu-link">
                <i class="bi bi-house-door"></i> Trang chủ
            </a>
            <a asp-controller="Account" asp-action="ChangePassword" class="menu-link link-warning">
                <i class="bi bi-shield-lock"></i> Đổi mật khẩu
            </a>
            <a href="/Account/Logout" class="menu-link link-danger">
                <i class="bi bi-box-arrow-left"></i> Đăng xuất
            </a>

        </div>
    </div>

    <div class="admin-main">
        <header class="admin-navbar">
            <div class="d-flex align-items-center gap-2">
                <h5 class="mb-0 fw-semibold text-dark">@ViewData["Title"]</h5>
            </div>
            <div class="d-flex align-items-center gap-3">
                <div class="text-end d-none d-md-block">
                    <span class="d-block fw-semibold" style="font-size: 0.9rem;">@User.Identity?.Name</span>
                    <span class="badge bg-success-subtle text-success border border-success-subtle" style="font-size: 0.7rem;">Administrator</span>
                </div>
                <div class="bg-success rounded-circle text-white d-flex align-items-center justify-content-center" style="width: 40px; height: 40px; font-weight: 600;">
                    @User.Identity?.Name?[0].ToString().ToUpper()
                </div>
            </div>
        </header>

        <main class="admin-content">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @RenderBody()
        </main>
    </div>

    <partial name="_AiChatWidget" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
