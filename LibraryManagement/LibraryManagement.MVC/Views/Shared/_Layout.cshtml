<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Thư viện sách</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/LibraryManagement.MVC.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="public-layout">
    <header>
        <nav class="navbar navbar-expand-lg public-navbar sticky-top">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-book text-success fs-3"></i>
                    <span class="brand-text">Thư viện sách</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse">
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0 gap-3">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Trang chủ</a>
                        </li>
                        @if (User.IsInRole("Reader"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Books" asp-action="Index">Mượn sách</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Loans" asp-action="Index">Sách đang mượn</a>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="roomDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Phòng thư viện
                                </a>
                                <ul class="dropdown-menu shadow-sm border-0" aria-labelledby="roomDropdown" style="border-radius: 0.75rem;">
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Rooms" asp-action="Index">
                                            <i class="bi bi-door-open me-2 text-success"></i> Đặt phòng
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Rooms" asp-action="MyReservations">
                                            <i class="bi bi-calendar-check me-2 text-primary"></i> Phòng đã đặt
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                        @if (User.IsInRole("Librarian"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Librarian" asp-action="Index">Quản lý thư viện</a>
                            </li>
                        }
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Index">Quản trị</a>
                            </li>
                        }
                    </ul>
                    <div class="d-flex align-items-center gap-3">
                        <a href="#" class="public-nav-icon" aria-label="Tìm kiếm"><i class="bi bi-search fs-5"></i></a>
                        <button type="button" class="theme-toggle" data-theme-toggle aria-label="Bật chế độ tối" aria-pressed="false">
                            <i class="bi bi-brightness-high fs-5" data-theme-icon></i>
                        </button>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <div class="dropdown">
                                <a href="#" class="d-flex align-items-center text-decoration-none dropdown-toggle" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false" style="color: var(--text-dark);">
                                    <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 38px; height: 38px; background-color: var(--brand-green); color: white;">
                                        <i class="bi bi-person-fill fs-5"></i>
                                    </div>
                                    <span class="ms-2 fw-medium d-none d-sm-block">@(User.Identity.Name ?? "Người dùng")</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-3" aria-labelledby="userDropdown" style="border-radius: 0.75rem;">
                                    <li><a class="dropdown-item py-2" asp-controller="UserProfile" asp-action="Index"><i class="bi bi-person me-2 text-muted"></i>Hồ sơ cá nhân</a></li>
                                    @if (User.IsInRole("Reader"))
                                    {
                                        <li><a class="dropdown-item py-2" asp-controller="Loans" asp-action="Index"><i class="bi bi-journal-bookmark me-2 text-muted"></i> Sách đang mượn </a></li>
                                        <li><a class="dropdown-item py-2" asp-controller="Loan" asp-action="Index"><i class="bi bi-journal-bookmark me-2 text-muted"></i> Lịch sử mượn sách </a></li>
                                    }
                                    <li><a class="dropdown-item py-2" asp-controller="Account" asp-action="ChangePassword"><i class="bi bi-journal-bookmark me-2 text-muted"></i> Đổi mật khẩu </a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                            <button type="submit" class="dropdown-item py-2 text-danger"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-brand">Đăng nhập</a>
                            <a asp-controller="Account" asp-action="Register" class="btn btn-brand">Đăng ký</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        <div class="container mt-4">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-4" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-4" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
        </div>
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4">
                    <a class="d-flex align-items-center gap-2 mb-3 text-decoration-none" href="#">
                        <i class="bi bi-book text-success fs-4"></i>
                        <span class="brand-text">Thư viện sách online</span>
                    </a>
                    <p class="footer-text">
                       Thư viện sách cộng đồng cho phép người dùng mượn/trả sách đa thể loại dễ dàng tiện lợi. Chúng tôi có rất nhiều sách thuộc nhiều thể loại.
                    </p>
                </div>
                <div class="col-lg-2 offset-lg-1">
                    <h5 class="footer-heading">Về chúng tôi</h5>
                    <ul class="footer-links">
                        <li><a href="#">Giới thiệu</a></li>
                    </ul>
                </div>
                <div class="col-lg-2">
                    <h5 class="footer-heading">Hỗ trợ</h5>
                    <ul class="footer-links">
                        <li><a href="#">Bản quyền nội dung</a></li>
                        <li><a href="#">Quy định sử dụng</a></li>
                        <li><a href="#">Chính sách bảo mật</a></li>
                    </ul>
                </div>
                <div class="col-lg-3">
                    <h5 class="footer-heading">Thông báo</h5>
                    <p class="footer-text">
                        Mọi thông tin và hình ảnh trên website đều được sưu tầm trên Internet. Chúng tôi không sở hữu hay chịu trách nhiệm bất kỳ thông tin nào trên web này. Nếu làm ảnh hưởng đến cá nhân hay tổ chức nào, khi được yêu cầu, chúng tôi sẽ xem xét và gỡ bỏ ngay lập tức.
                    </p>
                    <p class="footer-text mt-3">Email phản hồi: <a href="mailto:thuviensach@gmail.com" class="text-success text-decoration-none">thuviensach@gmail.com</a></p>
                </div>
            </div>
            <div class="footer-bottom">
                <div>Copyright &copy; 2026. All rights reserved.</div>
                <div class="d-flex gap-3">
                    <a href="#" class="text-muted"><i class="bi bi-facebook"></i></a>
                    <a href="#" class="text-muted"><i class="bi bi-twitter"></i></a>
                    <a href="#" class="text-muted"><i class="bi bi-linkedin"></i></a>
                    <a href="#" class="text-muted"><i class="bi bi-pinterest"></i></a>
                    <a href="#" class="text-muted"><i class="bi bi-tiktok"></i></a>
                </div>
            </div>
        </div>
    </footer>

    @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Reader"))
    {
        <partial name="_AiChatWidget" />
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
