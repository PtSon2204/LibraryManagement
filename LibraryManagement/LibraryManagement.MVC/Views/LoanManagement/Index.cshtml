@model LibraryManagement.MVC.ViewModels.Loans.ReaderLoanSummaryPageViewModel

@{
    ViewData["Title"] = "Quản lý mượn trả";
    Layout = "~/Views/Shared/_LibrarianLayout.cshtml";
    var search = Model.Search;
}

<div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1">Quản lý mượn trả theo độc giả</h2>
        <p class="text-muted mb-0">Tổng hợp yêu cầu, sách đang mượn, quá hạn và tiền phạt theo từng độc giả.</p>
    </div>
    <a asp-controller="Books" asp-action="Index" class="btn btn-outline-primary">
        <i class="bi bi-search me-2"></i>Tra cứu sách
    </a>
</div>

<form method="get" class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-4">
        <div class="row g-3 align-items-end">
            <div class="col-lg-8">
                <label class="form-label fw-semibold">Tìm độc giả</label>
                <input class="form-control" name="Search" value="@search.Search" placeholder="Tên, email hoặc số điện thoại" />
            </div>
            <div class="col-lg-4">
                <input type="hidden" name="PageSize" value="@search.PageSize" />
                <button class="btn btn-brand w-100" type="submit">Lọc độc giả</button>
            </div>
        </div>
    </div>
</form>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-header bg-white border-0 p-4 d-flex justify-content-between align-items-center">
        <div>
            <h5 class="fw-bold mb-1">Danh sách độc giả đang có giao dịch</h5>
            <p class="text-muted small mb-0">Tổng cộng: @Model.TotalCount độc giả</p>
        </div>
    </div>
    <div class="card-body p-0">
        @if (!Model.Readers.Any())
        {
            <div class="text-center text-muted py-5">
                <i class="bi bi-people fs-1 d-block mb-3"></i>
                Không tìm thấy độc giả phù hợp.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Độc giả</th>
                            <th>Số điện thoại</th>
                            <th>Chờ xác nhận</th>
                            <th>Đang mượn</th>
                            <th>Quá hạn</th>
                            <th>Phạt chưa trả</th>
                            <th>Trạng thái</th>
                            <th class="text-end">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var reader in Model.Readers)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">@reader.ReaderName</div>
                                    <div class="text-muted small">@reader.Email</div>
                                </td>
                                <td>@(reader.Phone ?? "N/A")</td>
                                <td><span class="badge bg-warning-subtle text-warning">@reader.PendingCount</span></td>
                                <td><span class="badge bg-primary-subtle text-primary">@reader.BorrowedCount</span></td>
                                <td><span class="badge bg-danger-subtle text-danger">@reader.OverdueCount</span></td>
                                <td>
                                    @if (reader.UnpaidFineCount > 0)
                                    {
                                        <span class="fw-semibold text-danger">@reader.UnpaidFineAmount.ToString("N0") đ</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">0 đ</span>
                                    }
                                </td>
                                <td><span class="badge text-bg-light">@reader.ReaderStatus</span></td>
                                <td class="text-end">
                                    <a asp-controller="LoanManagement" asp-action="Reader" asp-route-id="@reader.ReaderId" class="btn btn-sm btn-outline-primary">Quản lý</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-4" aria-label="Reader loan management pages">
        <ul class="pagination justify-content-center">
            @for (var currentPage = 1; currentPage <= Model.TotalPages; currentPage++)
            {
                <li class="page-item @(currentPage == search.Page ? "active" : "")">
                    <a class="page-link"
                       asp-controller="LoanManagement"
                       asp-action="Index"
                       asp-route-Search="@search.Search"
                       asp-route-Page="@currentPage"
                       asp-route-PageSize="@search.PageSize">@currentPage</a>
                </li>
            }
        </ul>
    </nav>
}
