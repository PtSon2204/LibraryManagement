@model LibraryManagement.MVC.ViewModels.Loans.ReaderLoanWorkspaceViewModel

@{
    ViewData["Title"] = "Quản lý mượn trả độc giả";
    Layout = "~/Views/Shared/_LibrarianLayout.cshtml";
}

<div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3 mb-4">
    <div>
        <a asp-controller="LoanManagement" asp-action="Index" class="text-decoration-none small fw-semibold d-inline-flex align-items-center mb-2">
            <i class="bi bi-arrow-left me-2"></i>Quay lại danh sách độc giả
        </a>
        <h2 class="fw-bold mb-1">@Model.ReaderName</h2>
        <p class="text-muted mb-0">@Model.Email · @(Model.Phone ?? "Chưa có số điện thoại") · @Model.ReaderStatus</p>
    </div>
    <a asp-controller="Books" asp-action="Index" class="btn btn-outline-primary">
        <i class="bi bi-search me-2"></i>Tra cứu sách
    </a>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 h-100"><div class="card-body"><div class="text-muted small">Chờ xác nhận</div><div class="h3 fw-bold mb-0">@Model.PendingLoans.Count</div></div></div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 h-100"><div class="card-body"><div class="text-muted small">Đang mượn</div><div class="h3 fw-bold mb-0">@Model.BorrowedLoans.Count</div></div></div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 h-100"><div class="card-body"><div class="text-muted small">Quá hạn</div><div class="h3 fw-bold mb-0 text-danger">@Model.OverdueLoans.Count</div></div></div>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-header bg-white border-0 p-4">
        <h5 class="fw-bold mb-1">Yêu cầu chờ xác nhận</h5>
        <p class="text-muted small mb-0">Chọn nhiều sách và bản sao thực tế để xác nhận mượn cùng lúc.</p>
    </div>
    <div class="card-body p-0">
        @if (!Model.PendingLoans.Any())
        {
            <div class="text-center text-muted py-5">Không có yêu cầu chờ xác nhận.</div>
        }
        else
        {
            <form asp-controller="LoanManagement" asp-action="ConfirmSelected" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="readerId" value="@Model.ReaderId" />
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 56px;">Chọn</th>
                                <th>Sách</th>
                                <th>Ngày yêu cầu</th>
                                <th>Bản sao giao cho độc giả</th>
                                <th class="text-end">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < Model.PendingLoans.Count; i++)
                            {
                                var loan = Model.PendingLoans[i];
                                <tr>
                                    <td>
                                        <input class="form-check-input" type="checkbox" name="items[@i].LoanDetailId" value="@loan.LoanDetailId" checked />
                                    </td>
                                    <td class="fw-semibold">@loan.BookTitle</td>
                                    <td>@loan.BorrowedAt.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        <select class="form-select form-select-sm" name="items[@i].CopyId" required>
                                            @foreach (var copy in loan.CopyOptions)
                                            {
                                                <option value="@copy.CopyId">@copy.Barcode - @(copy.SlotLocation ?? "Chưa xếp kệ")</option>
                                            }
                                        </select>
                                    </td>
                                    <td class="text-end">
                                        <button type="button" class="btn btn-sm btn-outline-danger" onclick="openRejectModal('@loan.LoanDetailId', '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(loan.BookTitle))')">
                                            Từ chối
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="p-4 border-top d-flex justify-content-end">
                    <button type="submit" class="btn btn-brand">Xác nhận các sách đã chọn</button>
                </div>
            </form>
        }
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-header bg-white border-0 p-4">
        <h5 class="fw-bold mb-1">Sách đang mượn</h5>
        <p class="text-muted small mb-0">Ghi nhận trả sách tại quầy khi độc giả mang sách đến.</p>
    </div>
    <div class="card-body p-0">
        @if (!Model.BorrowedLoans.Any())
        {
            <div class="text-center text-muted py-5">Không có sách đang mượn.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light"><tr><th>Sách</th><th>Bản sao</th><th>Hạn trả</th><th class="text-end">Thao tác</th></tr></thead>
                    <tbody>
                        @foreach (var loan in Model.BorrowedLoans)
                        {
                            <tr>
                                <td class="fw-semibold">@loan.BookTitle</td>
                                <td><span class="badge text-bg-light">@loan.Barcode</span></td>
                                <td>@loan.DueAt.ToString("dd/MM/yyyy")</td>
                                <td class="text-end">
                                    <form asp-controller="LoanManagement" asp-action="Return" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="loanDetailId" value="@loan.LoanDetailId" />
                                        <input type="hidden" name="ReaderId" value="@Model.ReaderId" />
                                        <button type="submit" class="btn btn-sm btn-outline-success">Ghi nhận trả</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@if (Model.OverdueLoans.Any())
{
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white border-0 p-4">
            <h5 class="fw-bold mb-1 text-danger">Sách quá hạn</h5>
            <p class="text-muted small mb-0">Ưu tiên xử lý khi độc giả đến quầy.</p>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light"><tr><th>Sách</th><th>Bản sao</th><th>Hạn trả</th><th class="text-end">Thao tác</th></tr></thead>
                    <tbody>
                        @foreach (var loan in Model.OverdueLoans)
                        {
                            <tr>
                                <td class="fw-semibold">@loan.BookTitle</td>
                                <td><span class="badge text-bg-light">@loan.Barcode</span></td>
                                <td class="text-danger fw-semibold">@loan.DueAt.ToString("dd/MM/yyyy")</td>
                                <td class="text-end">
                                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="openFineModal('@loan.LoanDetailId', @((int)Math.Max(0, (DateTime.UtcNow.Date - loan.DueAt.Date).TotalDays)))">
                                        Tạo khoản phạt
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<!-- Reject Modal -->
<div class="modal fade" id="rejectModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold text-danger">Từ chối yêu cầu mượn</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="mb-3">Bạn đang từ chối yêu cầu mượn sách: <strong id="rejectBookTitle"></strong></p>
                <form id="rejectForm" asp-controller="LoanManagement" asp-action="Reject" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="loanDetailId" id="rejectLoanDetailId" />
                    <input type="hidden" name="ReaderId" value="@Model.ReaderId" />
                    
                    <div class="mb-3">
                        <label class="form-label text-muted small fw-semibold">Lý do từ chối (tùy chọn, sẽ gửi qua email cho độc giả)</label>
                        <textarea class="form-control" name="reason" id="rejectReason" rows="3" placeholder="Nhập lý do..."></textarea>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-2">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn btn-danger">Xác nhận từ chối</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Fine Modals -->
<div class="modal fade" id="fineModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold">Tạo khoản phạt</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small mb-3">Chọn các loại phạt áp dụng cho sách này.</p>
                <form id="fineForm" asp-controller="LoanManagement" asp-action="CreateFine" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="LoanDetailId" id="fineLoanDetailId" />
                    <input type="hidden" name="ReaderId" value="@Model.ReaderId" />
                    <input type="hidden" name="OverdueDays" id="fineOverdueDays" />
                    <input type="hidden" name="PaymentMethod" id="finePaymentMethod" value="Cash" />
                    
                    <div id="fineTemplatesContainer" class="mb-3">
                        <div class="text-center text-muted py-3">Đang tải dữ liệu...</div>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Ghi chú (Không bắt buộc)</label>
                        <textarea class="form-control" name="Note" rows="2" placeholder="Nhập ghi chú thêm..."></textarea>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                        <div class="fw-bold">Tổng cộng: <span id="fineTotalAmount" class="text-danger fs-5">0</span>đ</div>
                        <button type="button" class="btn btn-brand" onclick="openPaymentModal()">Thanh toán</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="paymentModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold">Thanh toán khoản phạt</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <ul class="nav nav-pills nav-fill mb-3" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="cash-tab" data-bs-toggle="pill" data-bs-target="#cash" type="button" role="tab" onclick="setPaymentMethod('Cash')">
                            <i class="bi bi-cash-stack me-2"></i>Tiền mặt
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="transfer-tab" data-bs-toggle="pill" data-bs-target="#transfer" type="button" role="tab" onclick="setPaymentMethod('Transfer')">
                            <i class="bi bi-qr-code-scan me-2"></i>Chuyển khoản
                        </button>
                    </li>
                </ul>
                <div class="tab-content" id="paymentTabContent">
                    <div class="tab-pane fade show active" id="cash" role="tabpanel">
                        <div class="alert alert-info border-0 rounded-3 text-center mb-0">
                            <p class="mb-2">Vui lòng thu tiền mặt từ độc giả:</p>
                            <h3 class="fw-bold text-dark mb-0 payment-total-display">0đ</h3>
                        </div>
                        <div class="mt-4 text-end">
                            <button type="button" class="btn btn-light me-2" data-bs-toggle="modal" data-bs-target="#fineModal">Quay lại</button>
                            <button type="button" class="btn btn-success" onclick="submitFineForm()">Xác nhận đã thu tiền</button>
                        </div>
                    </div>
                    <div class="tab-pane fade" id="transfer" role="tabpanel">
                        <div class="text-center">
                            <div class="mb-2 text-muted small">Quét mã QR bằng ứng dụng ngân hàng</div>
                            <img id="qrImage" src="" alt="QR Code" class="img-fluid border p-2 rounded-3 mb-3" style="max-width: 250px;" />
                            <h4 class="fw-bold text-dark payment-total-display">0đ</h4>
                            <div class="small text-muted mb-3" id="transferContentDisplay"></div>
                            
                            <div id="sepayStatus" class="alert alert-warning border-0 rounded-3 py-2 mb-3">
                                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                Đang chờ thanh toán...
                            </div>
                        </div>
                        <div class="mt-3 d-flex justify-content-between">
                            <button type="button" class="btn btn-light" data-bs-toggle="modal" data-bs-target="#fineModal">Quay lại</button>
                            <button type="button" class="btn btn-outline-success" onclick="submitFineForm()">Đã nhận chuyển khoản (Thủ công)</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let fineTemplates = [];
        let currentOverdueDays = 0;
        let transferContent = '';
        let currentTotal = 0;
        let sepayInterval = null;

        function openFineModal(loanDetailId, overdueDays) {
            $('#fineLoanDetailId').val(loanDetailId);
            $('#fineOverdueDays').val(overdueDays);
            currentOverdueDays = overdueDays;
            
            // Load templates
            $.get('@Url.Action("GetFineTemplates", "LoanManagement")', function (data) {
                fineTemplates = data;
                let html = '';
                
                data.forEach((template, index) => {
                    let amount = template.amount;
                    let amountLabel = amount.toLocaleString() + 'đ';
                    let isChecked = false;
                    
                    if (template.fineType === 'PerDay') {
                        amountLabel = amount.toLocaleString() + 'đ/ngày';
                        amount = amount * overdueDays;
                        // Auto-select overdue if overdue days > 0
                        if (template.name.toLowerCase().includes('quá hạn') && overdueDays > 0) {
                            isChecked = true;
                        }
                    }

                    html += `
                        <div class="form-check mb-2">
                            <input class="form-check-input fine-checkbox" type="checkbox" 
                                id="fine_${index}" 
                                name="SelectedItems[${index}].FineTemplateId" 
                                value="${template.fineTemplateId}" 
                                data-amount="${amount}" 
                                ${isChecked ? 'checked' : ''}
                                onchange="calculateTotal()">
                            <input type="hidden" name="SelectedItems[${index}].Amount" value="${amount}" />
                            <label class="form-check-label w-100 d-flex justify-content-between" for="fine_${index}">
                                <span>${template.name} ${template.fineType === 'PerDay' ? `(${overdueDays} ngày)` : ''}</span>
                                <span class="fw-semibold text-danger">${amount.toLocaleString()}đ</span>
                            </label>
                        </div>
                    `;
                });
                
                $('#fineTemplatesContainer').html(html);
                calculateTotal();
                
                var modal = new bootstrap.Modal(document.getElementById('fineModal'));
                modal.show();
            });
        }

        function calculateTotal() {
            currentTotal = 0;
            $('.fine-checkbox:checked').each(function () {
                currentTotal += parseFloat($(this).data('amount'));
            });
            $('#fineTotalAmount').text(currentTotal.toLocaleString());
            $('.payment-total-display').text(currentTotal.toLocaleString() + 'đ');
            
            // Tắt các input Amount ẩn của checkbox không được chọn để ko gửi lên server
            $('.fine-checkbox').each(function () {
                $(this).next('input[type="hidden"]').prop('disabled', !this.checked);
            });
        }

        function openPaymentModal() {
            if (currentTotal <= 0) {
                alert("Vui lòng chọn ít nhất một khoản phạt.");
                return;
            }
            
            var fineModal = bootstrap.Modal.getInstance(document.getElementById('fineModal'));
            fineModal.hide();
            
            setPaymentMethod('Cash');
            $('#cash-tab').tab('show');
            
            var paymentModal = new bootstrap.Modal(document.getElementById('paymentModal'));
            paymentModal.show();
        }

        function setPaymentMethod(method) {
            $('#finePaymentMethod').val(method);
            
            if (method === 'Transfer') {
                $('#sepayStatus').removeClass('alert-success alert-danger').addClass('alert-warning')
                    .html('<span class="spinner-border spinner-border-sm me-2" role="status"></span> Đang tạo mã QR...');
                
                // Fetch QR từ Backend thay vì tự tạo ở Frontend
                $.get('@Url.Action("GenerateQr", "LoanManagement")', { amount: currentTotal, loanDetailId: $('#fineLoanDetailId').val() })
                    .done(function (res) {
                        transferContent = res.transferContent;
                        $('#transferContentDisplay').text('Nội dung: ' + transferContent);
                        $('#qrImage').attr('src', res.qrUrl);
                        
                        startSePayPolling();
                    })
                    .fail(function() {
                        $('#sepayStatus').removeClass('alert-warning').addClass('alert-danger')
                            .html('<i class="bi bi-x-circle-fill me-2"></i> Lỗi tạo QR. Vui lòng thu tiền mặt.');
                    });
            } else {
                stopSePayPolling();
            }
        }
        
        function startSePayPolling() {
            stopSePayPolling();
            $('#sepayStatus').removeClass('alert-success alert-danger').addClass('alert-warning')
                .html('<span class="spinner-border spinner-border-sm me-2" role="status"></span> Đang chờ thanh toán...');
                
            sepayInterval = setInterval(function() {
                $.get('/api/sepay/check', { transferContent: transferContent, amount: currentTotal }, function(res) {
                    if (res.received && res.amountMatch) {
                        stopSePayPolling();
                        $('#sepayStatus').removeClass('alert-warning').addClass('alert-success')
                            .html('<i class="bi bi-check-circle-fill me-2"></i>Đã nhận thanh toán!');
                        
                        setTimeout(function() {
                            submitFineForm();
                        }, 1500);
                    }
                });
            }, 3000); // Check every 3s
        }
        
        function stopSePayPolling() {
            if (sepayInterval) {
                clearInterval(sepayInterval);
                sepayInterval = null;
            }
        }

        function submitFineForm() {
            stopSePayPolling();
            $('#fineForm').submit();
        }
        
        // Dọn dẹp polling khi đóng modal
        document.getElementById('paymentModal').addEventListener('hidden.bs.modal', function () {
            stopSePayPolling();
        });
    </script>
}
