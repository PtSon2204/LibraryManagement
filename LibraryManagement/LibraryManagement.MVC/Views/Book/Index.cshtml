@model LibraryManagement.MVC.ViewModels.Books.BookListViewModel

@{
    ViewData["Title"] = "Quản lý sách";
    Layout = User.IsInRole("Admin") ? "~/Views/Shared/_AdminLayout.cshtml" : "~/Views/Shared/_LibrarianLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-1 fw-bold">Danh sách sách</h4>
        <small class="text-muted">Tổng cộng @Model.TotalRecords cuốn sách</small>
    </div>
    <button class="btn btn-primary" onclick="openCreateModal()">
        <i class="bi bi-plus-lg me-1"></i> Thêm sách mới
    </button>
</div>

<!-- Tìm kiếm & Lọc -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small text-muted mb-1">Tìm kiếm tên sách / ISBN</label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0">
                        <i class="bi bi-search text-muted"></i>
                    </span>
                    <input type="text" name="searchTerm" class="form-control border-start-0 ps-0"
                           placeholder="Nhập tên sách hoặc ISBN..." value="@Model.SearchTerm" />
                </div>
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted mb-1">Năm xuất bản</label>
                <input type="number" name="publicationYear" class="form-control"
                       placeholder="VD: 2023" value="@Model.PublicationYear" min="1900" max="2100" />
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted mb-1">Ngôn ngữ</label>
                <input type="text" name="language" class="form-control"
                       placeholder="VD: Tiếng Việt" value="@Model.Language" />
            </div>
            <input type="hidden" name="pageSize" value="@Model.PageSize" />
            <div class="col-md-auto d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-funnel me-1"></i> Lọc
                </button>
                @if (!string.IsNullOrWhiteSpace(Model.SearchTerm) || Model.PublicationYear.HasValue || !string.IsNullOrWhiteSpace(Model.Language))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-x-lg"></i> Xóa lọc
                    </a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Bảng dữ liệu -->
<div class="card border-0 shadow-sm rounded-3">
    <div class="card-body p-0">
        @if (Model.Data.Count == 0)
        {
            <div class="text-center py-5">
                <i class="bi bi-book fs-1 text-muted opacity-50"></i>
                <p class="text-muted mt-3">Không tìm thấy sách nào.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4" style="width:50px;">#</th>
                            <th>Tên sách</th>
                            <th>ISBN</th>
                            <th>Nhà xuất bản</th>
                            <th>Năm XB</th>
                            <th>Ngôn ngữ</th>
                            <th>Phiên bản</th>
                            @if (User.IsInRole("Admin"))
                            {
                                <th>Trạng thái</th>
                            }
                            <th class="text-center pe-4" style="width:160px;">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var stt = (Model.PageNumber - 1) * Model.PageSize + 1;
                        }
                        @foreach (var item in Model.Data)
                        {
                            <tr>
                                <td class="ps-4 text-muted">@(stt++)</td>
                                <td class="fw-medium">
                                    @if (!string.IsNullOrEmpty(item.CoverImageUrl))
                                    {
                                        <img src="@item.CoverImageUrl" alt="@item.Title"
                                             class="rounded me-2" style="width:36px;height:48px;object-fit:cover;" />
                                    }
                                    else
                                    {
                                        <span class="bg-secondary bg-opacity-10 rounded me-2 d-inline-flex align-items-center justify-content-center"
                                              style="width:36px;height:48px;vertical-align:middle;">
                                            <i class="bi bi-book text-secondary" style="font-size:1rem;"></i>
                                        </span>
                                    }
                                    @item.Title
                                </td>
                                <td><span class="text-muted">@(item.ISBN ?? "—")</span></td>
                                <td>@(item.PublisherName ?? "—")</td>
                                <td>@(item.PublicationYear?.ToString() ?? "—")</td>
                                <td>@(item.Language ?? "—")</td>
                                <td>@(item.Edition ?? "—")</td>
                                @if (User.IsInRole("Admin"))
                                {
                                    <td>
                                        @if (item.IsHidden)
                                        {
                                            <span class="badge bg-secondary">Đã ẩn</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">Đang hiển thị</span>
                                        }
                                    </td>
                                }
                                <td class="text-center pe-4">
                                    <div class="d-flex justify-content-center gap-1">
                                        <a class="btn btn-sm btn-outline-primary" title="Quản lý bản sao"
                                           asp-controller="BookCopies" asp-action="Index" asp-route-bookId="@item.BookId">
                                            <i class="bi bi-collection"></i>
                                        </a>
                                        <button class="btn btn-sm btn-outline-info" title="Chi tiết"
                                                onclick="openDetailsModal('@item.BookId')">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-warning" title="Chỉnh sửa"
                                                onclick="openEditModal('@item.BookId')">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <button class="btn btn-sm @(item.IsHidden ? "btn-outline-success" : "btn-outline-secondary")"
                                                    title="@(item.IsHidden ? "Hiện sách" : "Ẩn sách")"
                                                    onclick="toggleHide('@item.BookId')">
                                                <i class="bi @(item.IsHidden ? "bi-eye" : "bi-eye-slash")"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Phân trang -->
            @if (Model.TotalPages > 1)
            {
                <div class="d-flex justify-content-between align-items-center px-4 py-3 border-top">
                    <small class="text-muted">
                        Trang @Model.PageNumber / @Model.TotalPages
                        &nbsp;•&nbsp; @Model.TotalRecords bản ghi
                    </small>
                    <nav>
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-searchTerm="@Model.SearchTerm"
                                   asp-route-publisherId="@Model.PublisherId"
                                   asp-route-publicationYear="@Model.PublicationYear"
                                   asp-route-language="@Model.Language"
                                   asp-route-pageNumber="@(Model.PageNumber - 1)"
                                   asp-route-pageSize="@Model.PageSize">
                                    <i class="bi bi-chevron-left"></i>
                                </a>
                            </li>
                            @for (int i = Math.Max(1, Model.PageNumber - 2); i <= Math.Min(Model.TotalPages, Model.PageNumber + 2); i++)
                            {
                                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-route-searchTerm="@Model.SearchTerm"
                                       asp-route-publisherId="@Model.PublisherId"
                                       asp-route-publicationYear="@Model.PublicationYear"
                                       asp-route-language="@Model.Language"
                                       asp-route-pageNumber="@i"
                                       asp-route-pageSize="@Model.PageSize">@i</a>
                                </li>
                            }
                            <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-searchTerm="@Model.SearchTerm"
                                   asp-route-publisherId="@Model.PublisherId"
                                   asp-route-publicationYear="@Model.PublicationYear"
                                   asp-route-language="@Model.Language"
                                   asp-route-pageNumber="@(Model.PageNumber + 1)"
                                   asp-route-pageSize="@Model.PageSize">
                                    <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        }
    </div>
</div>

<!-- Modal dùng chung -->
<div class="modal fade" id="bookModal" tabindex="-1" aria-labelledby="bookModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div id="bookModalBody"></div>
        </div>
    </div>
</div>


<!-- Toast thông báo -->
<div class="position-fixed bottom-0 end-0 p-3" style="z-index: 2000">
    <div id="toastMsg" class="toast align-items-center border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body fw-medium" id="toastText"></div>
            <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const bookModal = new bootstrap.Modal(document.getElementById('bookModal'));
        const toast = new bootstrap.Toast(document.getElementById('toastMsg'), { delay: 3000 });

        function showToast(message, isSuccess) {
            const toastEl = document.getElementById('toastMsg');
            toastEl.classList.remove('bg-success', 'bg-danger', 'text-white');
            toastEl.classList.add(isSuccess ? 'bg-success' : 'bg-danger', 'text-white');
            document.getElementById('toastText').textContent = message;
            toast.show();
        }

        function openCreateModal() {
            fetch('@Url.Action("GetCreateForm", "Book")')
                .then(r => r.text())
                .then(html => {
                    document.getElementById('bookModalBody').innerHTML = html;
                    bookModal.show();
                    attachFormSubmit('#createBookForm', '@Url.Action("Create", "Book")');
                });
        }

        function openEditModal(id) {
            fetch('@Url.Action("GetEditForm", "Book")/' + id)
                .then(r => r.text())
                .then(html => {
                    document.getElementById('bookModalBody').innerHTML = html;
                    bookModal.show();
                    attachFormSubmit('#editBookForm', '@Url.Action("Edit", "Book")');
                });
        }

        function openDetailsModal(id) {
            fetch('@Url.Action("GetDetails", "Book")/' + id)
                .then(r => r.text())
                .then(html => {
                    document.getElementById('bookModalBody').innerHTML = html;
                    bookModal.show();
                });
        }

        function attachFormSubmit(formSelector, actionUrl) {
            const form = document.querySelector(formSelector);
            if (!form) return;
            form.addEventListener('submit', function (e) {
                e.preventDefault();
                const formData = new FormData(form);
                fetch(actionUrl, {
                    method: 'POST',
                    body: formData
                })
                .then(r => {
                    const contentType = r.headers.get('Content-Type') || '';
                    if (contentType.includes('application/json')) {
                        return r.json().then(result => {
                            if (result.success) {
                                bookModal.hide();
                                showToast(result.message, true);
                                setTimeout(() => location.reload(), 1200);
                            } else {
                                showToast(result.message, false);
                            }
                        });
                    } else {
                        return r.text().then(html => {
                            document.getElementById('bookModalBody').innerHTML = html;
                            // Re-attach submit after partial re-render
                            attachFormSubmit(formSelector, actionUrl);
                        });
                    }
                });
            });
        }

        function toggleHide(id) {
            fetch('@Url.Action("ToggleHide", "Book")/' + id, {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: '__RequestVerificationToken=' + getAntiForgeryToken()
            })
            .then(r => r.json())
            .then(result => {
                showToast(result.message, result.success);
                if (result.success) setTimeout(() => location.reload(), 1200);
            });
        }

        function getAntiForgeryToken() {
            const el = document.querySelector('input[name="__RequestVerificationToken"]');
            return el ? el.value : '';
        }
    </script>
}
