@model LibraryManagement.MVC.ViewModels.Author.AuthorViewModel

<div class="modal-header border-0 pb-0">
    <h5 class="modal-title fw-bold text-dark">
        <i class="bi bi-plus-circle-fill text-primary me-2"></i>Thêm tác giả mới
    </h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>

<form id="createAuthorForm" novalidate>
    <div class="modal-body">
        <div class="row g-3">
            <div class="col-12">
                <label asp-for="FullName" class="form-label fw-medium">Tên tác giả <span class="text-danger">*</span></label>
                <input asp-for="FullName" class="form-control" placeholder="Nhập tên tác giả..." required />
                <span asp-validation-for="FullName" class="text-danger small"></span>
            </div>
        </div>
    </div>
    <div class="modal-footer border-0 pt-0">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
        <button type="submit" class="btn btn-primary px-4">
            <i class="bi bi-save me-1"></i>Lưu
        </button>
    </div>
</form>
