@model LibraryManagement.MVC.ViewModels.Author.AuthorListViewModel

@{
    ViewData["Title"] = "Quản lý tác giả";
    Layout = User.IsInRole("Admin") ? "~/Views/Shared/_AdminLayout.cshtml" : "~/Views/Shared/_LibrarianLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-1 fw-bold text-dark">Danh sách tác giả</h4>
        <small class="text-muted">Tổng cộng @Model.TotalRecords tác giả</small>
    </div>
    @if (User.IsInRole("Admin"))
    {
        <button class="btn btn-primary" onclick="openCreateModal()">
            <i class="bi bi-plus-lg me-1"></i> Thêm tác giả
        </button>
    }
</div>

<!-- Search -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="d-flex gap-2">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0">
                    <i class="bi bi-search text-muted"></i>
                </span>
                <input type="text"
                       name="search"
                       class="form-control border-start-0 ps-0"
                       placeholder="Tìm kiếm tác giả..."
                       value="@Model.Search" />
            </div>
            <input type="hidden" name="pageSize" value="@Model.PageSize" />
            <button type="submit" class="btn btn-primary px-4">
                <i class="bi bi-search me-1"></i> Tìm kiếm
            </button>
            @if (!string.IsNullOrWhiteSpace(Model.Search))
            {
                <a asp-action="Index" class="btn btn-outline-secondary px-3">
                    <i class="bi bi-x-lg"></i>
                </a>
            }
        </form>
    </div>
</div>

<!-- Table -->
<div class="card border-0 shadow-sm rounded-3">
    <div class="card-body p-0">
        @if (!Model.Data.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-journal-text fs-1 text-muted opacity-50"></i>
                <p class="text-muted mt-3">Không tìm thấy tác giả nào.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4" style="width: 80px;">#</th>
                            <th>Tên tác giả</th>
                            @if (User.IsInRole("Admin"))
                            {
                                <th class="text-center pe-4" style="width: 180px;">Thao tác</th>
                            }
                            else
                            {
                                <th class="text-center pe-4" style="width: 100px;">Chi tiết</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var stt = (Model.PageNumber - 1) * Model.PageSize + 1;
                        }
                        @foreach (var item in Model.Data)
                        {
                            <tr>
                                <td class="ps-4 text-muted">@(stt++)</td>
                                <td class="fw-medium text-dark">@item.FullName</td>
                                <td class="text-center pe-4">
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <div class="d-flex justify-content-center gap-1">
                                            <a asp-action="Details" asp-route-id="@item.AuthorId"
                                               class="btn btn-sm btn-outline-primary" title="Chi tiết">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <button class="btn btn-sm btn-outline-warning" title="Chỉnh sửa"
                                                    onclick="openEditModal('@item.AuthorId')">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger" title="Xóa"
                                                    onclick="deleteAuthor('@item.AuthorId', '@item.FullName')">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    }
                                    else
                                    {
                                        <a asp-action="Details" asp-route-id="@item.AuthorId"
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-eye"></i> Chi tiết
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            @if (Model.TotalPages > 1)
            {
                <div class="d-flex justify-content-between align-items-center px-4 py-3 border-top">
                    <small class="text-muted">
                        Trang @Model.PageNumber / @Model.TotalPages
                        &nbsp;•&nbsp; @Model.TotalRecords tác giả
                    </small>
                    <nav>
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-search="@Model.Search"
                                   asp-route-pageNumber="@(Model.PageNumber - 1)"
                                   asp-route-pageSize="@Model.PageSize">
                                    <i class="bi bi-chevron-left"></i>
                                </a>
                            </li>
                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-route-search="@Model.Search"
                                       asp-route-pageNumber="@i"
                                       asp-route-pageSize="@Model.PageSize">@i</a>
                                </li>
                            }
                            <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-search="@Model.Search"
                                   asp-route-pageNumber="@(Model.PageNumber + 1)"
                                   asp-route-pageSize="@Model.PageSize">
                                    <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        }
    </div>
</div>

<!-- Modal dùng chung -->
<div class="modal fade" id="authorModal" tabindex="-1" aria-labelledby="authorModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-md modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div id="authorModalBody"></div>
        </div>
    </div>
</div>

<!-- Toast thông báo -->
<div class="position-fixed bottom-0 end-0 p-3" style="z-index: 2000">
    <div id="toastMsg" class="toast align-items-center border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body fw-medium" id="toastText"></div>
            <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const authorModal = new bootstrap.Modal(document.getElementById('authorModal'));
        const toast = new bootstrap.Toast(document.getElementById('toastMsg'), { delay: 3000 });

        function showToast(message, isSuccess) {
            const toastEl = document.getElementById('toastMsg');
            toastEl.classList.remove('bg-success', 'bg-danger', 'text-white');
            toastEl.classList.add(isSuccess ? 'bg-success' : 'bg-danger', 'text-white');
            document.getElementById('toastText').textContent = message;
            toast.show();
        }

        function openCreateModal() {
            fetch('@Url.Action("GetCreateForm", "Author")')
                .then(r => r.text())
                .then(html => {
                    document.getElementById('authorModalBody').innerHTML = html;
                    authorModal.show();
                    attachFormSubmit('#createAuthorForm', '@Url.Action("Create", "Author")');
                });
        }

        function openEditModal(id) {
            fetch('@Url.Action("GetEditForm", "Author")/' + id)
                .then(r => r.text())
                .then(html => {
                    document.getElementById('authorModalBody').innerHTML = html;
                    authorModal.show();
                    attachFormSubmit('#editAuthorForm', '@Url.Action("Edit", "Author")');
                });
        }

        function attachFormSubmit(formSelector, actionUrl) {
            const form = document.querySelector(formSelector);
            if (!form) return;
            form.addEventListener('submit', function (e) {
                e.preventDefault();
                const formData = new FormData(form);
                fetch(actionUrl, {
                    method: 'POST',
                    body: formData
                })
                .then(r => {
                    const contentType = r.headers.get('Content-Type') || '';
                    if (contentType.includes('application/json')) {
                        return r.json().then(result => {
                            if (result.success) {
                                authorModal.hide();
                                showToast(result.message, true);
                                setTimeout(() => location.reload(), 1200);
                            } else {
                                showToast(result.message, false);
                            }
                        });
                    } else {
                        return r.text().then(html => {
                            document.getElementById('authorModalBody').innerHTML = html;
                            // Re-attach submit after partial re-render
                            attachFormSubmit(formSelector, actionUrl);
                        });
                    }
                });
            });
        }

        function deleteAuthor(id, name) {
            if (confirm(`Bạn có chắc chắn muốn xóa tác giả "${name}" không?`)) {
                fetch('@Url.Action("Delete", "Author")/' + id, {
                    method: 'POST'
                })
                .then(r => r.json())
                .then(result => {
                    showToast(result.message, result.success);
                    if (result.success) {
                        setTimeout(() => location.reload(), 1200);
                    }
                });
            }
        }
    </script>
}
