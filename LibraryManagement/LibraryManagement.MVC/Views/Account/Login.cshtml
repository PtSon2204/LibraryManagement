@using LibraryManagement.MVC.ViewModels.Auth
@model LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
}

<style>
    /* Custom styles for Auth Pages */
    .auth-container {
        min-height: calc(100vh - 160px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 3rem 1rem;
        background-color: #f9fafb;
        position: relative;
        overflow: hidden;
    }
    
    .auth-container::before {
        content: '';
        position: absolute;
        top: -50%;
        left: -50%;
        width: 200%;
        height: 200%;
        background: radial-gradient(circle at 50% 50%, rgba(16, 185, 129, 0.08) 0%, rgba(255, 255, 255, 0) 50%);
        z-index: 0;
        animation: rotate 60s linear infinite;
    }

    @@keyframes rotate {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }

    .auth-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.4);
        border-radius: 1.5rem;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.1), 0 10px 15px -3px rgba(0, 0, 0, 0.05);
        overflow: hidden;
        width: 100%;
        max-width: 950px;
        display: flex;
        z-index: 1;
        position: relative;
        transition: transform 0.3s ease;
    }

    .auth-card:hover {
        transform: translateY(-5px);
    }

    .auth-left {
        flex: 1;
        background: linear-gradient(135deg, var(--brand-green) 0%, #047857 100%);
        padding: 4rem 3rem;
        color: white;
        display: flex;
        flex-direction: column;
        justify-content: center;
        position: relative;
        overflow: hidden;
    }

    .auth-left::after {
        content: '';
        position: absolute;
        bottom: -50px;
        right: -50px;
        width: 250px;
        height: 250px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(5px);
    }
    
    .auth-left::before {
        content: '';
        position: absolute;
        top: -50px;
        left: -50px;
        width: 150px;
        height: 150px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(5px);
    }

    .auth-right {
        flex: 1;
        padding: 4rem 3rem;
        background: white;
    }

    .auth-title {
        font-size: 2.25rem;
        font-weight: 800;
        color: var(--text-dark);
        margin-bottom: 0.5rem;
        letter-spacing: -0.025em;
    }

    .auth-subtitle {
        color: var(--text-muted);
        margin-bottom: 2.5rem;
        font-size: 1.05rem;
    }

    .form-floating {
        margin-bottom: 1.25rem;
    }

    .form-floating > .form-control {
        border-radius: 0.75rem;
        border: 1px solid #e5e7eb;
        padding: 1rem 1.25rem;
        height: calc(3.5rem + 2px);
        background-color: #f9fafb;
        transition: all 0.3s ease;
    }

    .form-floating > .form-control:focus {
        background-color: white;
        border-color: var(--brand-green);
        box-shadow: 0 0 0 4px rgba(16, 185, 129, 0.1);
    }

    .form-floating > .form-control:focus ~ label,
    .form-floating > .form-control:not(:placeholder-shown) ~ label {
        color: var(--brand-green);
        transform: scale(.85) translateY(-.75rem) translateX(.15rem);
    }

    .form-floating > label {
        padding: 1rem 1.25rem;
        color: #9ca3af;
    }

    .btn-auth {
        width: 100%;
        padding: 1rem;
        font-size: 1.1rem;
        font-weight: 600;
        border-radius: 0.75rem;
        margin-top: 1rem;
        letter-spacing: 0.025em;
        box-shadow: 0 4px 6px -1px rgba(16, 185, 129, 0.2);
    }
    
    .btn-auth:hover {
        box-shadow: 0 10px 15px -3px rgba(16, 185, 129, 0.3);
    }

    .social-login {
        display: flex;
        gap: 1rem;
        margin-top: 1.5rem;
    }

    .btn-social {
        flex: 1;
        padding: 0.875rem;
        border: 1px solid #e5e7eb;
        border-radius: 0.75rem;
        background: white;
        color: var(--text-dark);
        font-weight: 600;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        transition: all 0.2s;
    }

    .btn-social:hover {
        background: #f9fafb;
        border-color: #d1d5db;
        transform: translateY(-2px);
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    }

    .divider {
        display: flex;
        align-items: center;
        text-align: center;
        margin: 2rem 0;
        color: var(--text-muted);
        font-size: 0.875rem;
        font-weight: 500;
    }

    .divider::before,
    .divider::after {
        content: '';
        flex: 1;
        border-bottom: 1px solid #e5e7eb;
    }

    .divider:not(:empty)::before {
        margin-right: 1em;
    }

    .divider:not(:empty)::after {
        margin-left: 1em;
    }

    @@media (max-width: 768px) {
        .auth-card {
            flex-direction: column;
            border-radius: 1rem;
        }
        .auth-left {
            padding: 3rem 2rem;
            text-align: center;
        }
        .auth-right {
            padding: 2.5rem 1.5rem;
        }
    }
</style>

<div class="auth-container">
    <div class="auth-card">
        <div class="auth-left d-none d-md-flex">
            <h2 class="display-5 fw-bold mb-4" style="line-height: 1.2;">Chào mừng<br/>trở lại!</h2>
            <p class="fs-5 mb-0" style="color: rgba(255,255,255,0.9); max-width: 90%;">
                Đăng nhập để khám phá hàng ngàn tựa sách hấp dẫn và tiếp tục hành trình tri thức của bạn.
            </p>
            <div class="mt-auto">
                <i class="bi bi-book-half" style="font-size: 4.5rem; opacity: 0.9; text-shadow: 0 10px 15px rgba(0,0,0,0.1);"></i>
            </div>
        </div>
        <div class="auth-right">
            <h1 class="auth-title">Đăng nhập</h1>
            <p class="auth-subtitle">Vui lòng nhập thông tin của bạn</p>
            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">
                    @ViewBag.Error
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">
                    @TempData["Error"]
                </div>
            }
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success">
                    @TempData["SuccessMessage"]
                </div>
            }
            <form asp-action="Login" asp-controller="Account" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 border-0 small"></div>

                <div class="form-floating">
                    <input asp-for="Email" class="form-control" placeholder="name@example.com" />
                    <label asp-for="Email">Email</label>
                    <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="form-floating">
                    <input asp-for="Password" type="password" class="form-control" placeholder="Mật khẩu" />
                    <label asp-for="Password">Mật khẩu</label>
                    <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-4 mt-2">
                    <div class="form-check">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label text-muted" style="font-size: 0.9rem;">
                            Ghi nhớ tôi
                        </label>
                    </div>
                    <a asp-action="ForgotPassword" asp-controller="Account" class="text-success text-decoration-none fw-semibold" style="font-size: 0.9rem;">Quên mật khẩu?</a>
                </div>

                <button type="submit" class="btn btn-brand btn-auth">
                    <i class="bi bi-box-arrow-in-right me-2"></i>Đăng nhập
                </button>
            </form>

            <div class="divider">hoặc tiếp tục với</div>

            <div class="social-login">
                <a asp-action="GoogleLogin" asp-controller="Account" class="btn-social">
                    <img src="https://www.svgrepo.com/show/475656/google-color.svg" alt="Google" width="22" height="22" />
                    Tiếp tục với Google
                </a>
            </div>

            <p class="text-center mt-4 pt-2 mb-0 text-muted">
                Chưa có tài khoản? <a asp-action="Register" asp-controller="Account" class="text-success text-decoration-none fw-bold">Đăng ký ngay</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
