@model LibraryManagement.Business.DTOs.AuthDTOs.LoginDto
@{
    ViewData["Title"] = "Đăng nhập";
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<div class="login-wrapper py-5">
    <div class="container">
        <div class="row justify-content-center align-items-center" style="min-height: 70vh;">
            <div class="col-md-5">
                <div class="card border-0 shadow-lg rounded-4 overflow-hidden login-card p-4 p-md-5">
                    <div class="text-center mb-4">
                        <i class="bi bi-book text-success fs-1 mb-2 d-inline-block"></i>
                        <h3 class="fw-bold text-dark">Chào mừng trở lại</h3>
                        <p class="text-muted">Đăng nhập vào hệ thống quản lý thư viện</p>
                    </div>

                    <form asp-action="Login" asp-route-returnUrl="@returnUrl" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        <div class="form-floating mb-3">
                            <input asp-for="Email" class="form-control rounded-3" placeholder="name@example.com" required />
                            <label asp-for="Email">Địa chỉ Email</label>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="form-floating mb-4">
                            <input asp-for="Password" type="password" class="form-control rounded-3" placeholder="Mật khẩu" required />
                            <label asp-for="Password">Mật khẩu</label>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-brand w-100 py-3 rounded-3 fw-bold mb-3">
                            Đăng nhập
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .login-wrapper {
        background-color: var(--bg-light);
        background-image: 
            linear-gradient(to right, rgba(16, 185, 129, 0.05) 1px, transparent 1px),
            linear-gradient(to bottom, rgba(16, 185, 129, 0.05) 1px, transparent 1px);
        background-size: 3rem 3rem;
    }
    .login-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(229, 231, 235, 0.5) !important;
        transition: transform 0.3s ease;
    }
    .form-control:focus {
        border-color: var(--brand-green);
        box-shadow: 0 0 0 0.25rem rgba(16, 185, 129, 0.15);
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
