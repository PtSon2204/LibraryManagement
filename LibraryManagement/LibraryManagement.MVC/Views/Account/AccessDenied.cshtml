                <div class="d-flex justify-content-center gap-3">
                    <a href="/" class="btn btn-outline-brand px-4 py-2">Về trang chủ</a>
                    <a href="/Account/Login" class="btn btn-brand px-4 py-2">Đăng nhập lại</a>
                </div>
