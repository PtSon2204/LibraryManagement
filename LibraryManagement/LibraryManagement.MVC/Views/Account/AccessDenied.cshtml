@{
    ViewData["Title"] = "Không có quyền truy cập";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="card border-0 shadow-sm p-5 rounded-4" style="background: var(--bg-light); border: 1px solid #e5e7eb !important;">
                <div class="mb-4">
                    <i class="bi bi-shield-slash text-danger" style="font-size: 5rem;"></i>
