@using LibraryManagement.MVC.ViewModels.Auth
@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên mật khẩu";
}

<style>
    /* Custom styles for Auth Pages */
    .auth-container {
        min-height: calc(100vh - 160px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 3rem 1rem;
        background-color: #f9fafb;
        position: relative;
        overflow: hidden;
    }
    
    .auth-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.4);
        border-radius: 1.5rem;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.1), 0 10px 15px -3px rgba(0, 0, 0, 0.05);
        overflow: hidden;
        width: 100%;
        max-width: 500px;
        display: flex;
        z-index: 1;
        position: relative;
        transition: transform 0.3s ease;
    }

    .auth-right {
        flex: 1;
        padding: 4rem 3rem;
        background: white;
    }

    .auth-title {
        font-size: 2.25rem;
        font-weight: 800;
        color: var(--text-dark);
        margin-bottom: 0.5rem;
        letter-spacing: -0.025em;
    }

    .auth-subtitle {
        color: var(--text-muted);
        margin-bottom: 2.5rem;
        font-size: 1.05rem;
    }

    .form-floating {
        margin-bottom: 1.25rem;
    }

    .form-floating > .form-control {
        border-radius: 0.75rem;
        border: 1px solid #e5e7eb;
        padding: 1rem 1.25rem;
        height: calc(3.5rem + 2px);
        background-color: #f9fafb;
        transition: all 0.3s ease;
    }

    .form-floating > .form-control:focus {
        background-color: white;
        border-color: var(--brand-green);
        box-shadow: 0 0 0 4px rgba(16, 185, 129, 0.1);
    }

    .form-floating > .form-control:focus ~ label,
    .form-floating > .form-control:not(:placeholder-shown) ~ label {
        color: var(--brand-green);
        transform: scale(.85) translateY(-.75rem) translateX(.15rem);
    }

    .form-floating > label {
        padding: 1rem 1.25rem;
        color: #9ca3af;
    }

    .btn-auth {
        width: 100%;
        padding: 1rem;
        font-size: 1.1rem;
        font-weight: 600;
        border-radius: 0.75rem;
        margin-top: 1rem;
        letter-spacing: 0.025em;
        box-shadow: 0 4px 6px -1px rgba(16, 185, 129, 0.2);
    }
    
    .btn-auth:hover {
        box-shadow: 0 10px 15px -3px rgba(16, 185, 129, 0.3);
    }
</style>

<div class="auth-container">
    <div class="auth-card">
        <div class="auth-right">
            <h1 class="auth-title">Khôi phục mật khẩu</h1>
            <p class="auth-subtitle">Nhập email để nhận mật khẩu mới</p>
            
            @if (ViewBag.Message != null)
            {
                <div class="alert alert-success">
                    @ViewBag.Message
                </div>
            }

            <form asp-action="ForgotPassword" asp-controller="Account" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 border-0 small"></div>

                <div class="form-floating">
                    <input asp-for="Email" class="form-control" placeholder="name@example.com" />
                    <label asp-for="Email">Email</label>
                    <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                </div>

                <button type="submit" class="btn btn-brand btn-auth">
                    Lấy mật khẩu mới
                </button>
            </form>

            <p class="text-center mt-4 pt-2 mb-0 text-muted">
                Quay lại <a asp-action="Login" asp-controller="Account" class="text-success text-decoration-none fw-bold">Đăng nhập</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
