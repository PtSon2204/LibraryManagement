@model LibraryManagement.MVC.ViewModels.Room.RoomViewModel

@{
    ViewData["Title"] = Model.RoomName;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Phòng học & đọc</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.RoomName</li>
        </ol>
    </nav>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-5">
        <div class="row g-0">
            <div class="col-lg-6 position-relative" style="min-height: 400px; background-color: #f8f9fa;">
                @if (!string.IsNullOrEmpty(Model.Image))
                {
                    <img src="@Model.Image" alt="@Model.RoomName" class="w-100 h-100 object-fit-cover position-absolute top-0 start-0">
                }
                else
                {
                    <div class="w-100 h-100 d-flex justify-content-center align-items-center text-muted position-absolute top-0 start-0">
                        <i class="bi bi-image" style="font-size: 5rem; opacity: 0.2;"></i>
                    </div>
                }
                
                <div class="position-absolute top-0 start-0 m-4">
                    @if (Model.Status == "Available")
                    {
                        <span class="badge bg-success bg-opacity-90 rounded-pill px-3 py-2 fs-6 shadow-sm">
                            <i class="bi bi-check-circle-fill me-1"></i> Có sẵn
                        </span>
                    }
                    else if (Model.Status == "Occupied")
                    {
                        <span class="badge bg-danger bg-opacity-90 rounded-pill px-3 py-2 fs-6 shadow-sm">
                            <i class="bi bi-x-circle-fill me-1"></i> Đang sử dụng
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-warning bg-opacity-90 rounded-pill px-3 py-2 fs-6 text-dark shadow-sm">
                            <i class="bi bi-wrench-adjustable-circle-fill me-1"></i> Đang bảo trì
                        </span>
                    }
                </div>
            </div>
            
            <div class="col-lg-6 d-flex flex-column">
                <div class="card-body p-5 flex-grow-1">
                    <h1 class="card-title fw-bold text-dark mb-4">@Model.RoomName</h1>
                    
                    <div class="d-flex flex-wrap gap-3 mb-4">
                        <div class="d-flex align-items-center text-success bg-success bg-opacity-10 p-3 rounded-3 d-inline-flex">
                            <i class="bi bi-people-fill fs-4 me-3"></i>
                            <div>
                                <small class="d-block text-muted text-uppercase fw-bold" style="font-size: 0.75rem;">Sức chứa tối đa</small>
                                <span class="fs-5 fw-bold">@Model.Capacity người</span>
                            </div>
                        </div>

                        <div class="d-flex align-items-center text-success bg-success bg-opacity-10 p-3 rounded-3 d-inline-flex">
                            <i class="bi bi-building fs-4 me-3"></i>
                            <div>
                                <small class="d-block text-muted text-uppercase fw-bold" style="font-size: 0.75rem;">Vị trí</small>
                                <span class="fs-5 fw-bold">@(string.IsNullOrEmpty(Model.FloorName) ? "Chưa sắp xếp" : Model.FloorName)</span>
                            </div>
                        </div>
                    </div>

                    <h5 class="fw-bold mb-3 mt-4">Thông tin chi tiết</h5>
                    <div class="bg-light rounded-4 p-4 text-muted" style="min-height: 120px; line-height: 1.6;">
                        @if (string.IsNullOrWhiteSpace(Model.Description))
                        {
                            <span class="fst-italic opacity-75">Không có mô tả chi tiết cho phòng này.</span>
                        }
                        else
                        {
                            @Html.Raw(Model.Description.Replace("\n", "<br />"))
                        }
                    </div>
                </div>
                
                <div class="card-footer bg-white border-top p-4 p-lg-5 mt-auto">
                    <div class="d-flex gap-3 align-items-center">
                        <a asp-action="Index" class="btn btn-light btn-lg px-4 rounded-pill fw-medium border">
                            <i class="bi bi-arrow-left me-2"></i>Quay lại
                        </a>
                        
                        @if (Model.Status == "Available")
                        {
                            @if (User.IsInRole("Reader") && !(bool)(ViewBag.HasPhone ?? true))
                            {
                                <!-- No phone - disabled button with warning -->
                                <a asp-controller="UserProfile" asp-action="Index" class="btn btn-warning btn-lg flex-grow-1 rounded-pill fw-bold shadow-sm">
                                    <i class="bi bi-exclamation-triangle-fill me-2"></i>Cập nhật SĐT để đặt phòng
                                </a>
                            }
                            else
                            {
                                <!-- Booking Modal Trigger -->
                                <button class="btn btn-success btn-lg flex-grow-1 rounded-pill fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#bookingModal">
                                    <i class="bi bi-calendar-plus me-2"></i>Đặt phòng ngay
                                </button>
                            }
                        }
                        else
                        {
                            <button class="btn btn-secondary btn-lg flex-grow-1 rounded-pill fw-bold" disabled>
                                <i class="bi bi-lock-fill me-2"></i>Hiện không thể đặt
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (Model.SuggestedRooms.Any())
    {
        <div class="mt-5">
            <div class="d-flex align-items-center gap-2 mb-4">
                <div class="bg-success bg-opacity-10 text-success rounded-3 p-2 d-inline-flex">
                    <i class="bi bi-stars fs-5"></i>
                </div>
                <div>
                    <h4 class="fw-bold mb-0">Phòng trống khác</h4>
                    <small class="text-muted">Các phòng hiện đang có sẵn để sử dụng</small>
                </div>
            </div>

            <div class="row g-4">
                @foreach (var room in Model.SuggestedRooms)
                {
                    <div class="col-sm-6 col-lg-3">
                        <a asp-action="Details" asp-route-id="@room.RoomId"
                           class="card border-0 shadow-sm rounded-4 overflow-hidden text-decoration-none h-100 suggested-room-card">
                            <!-- Hình ảnh -->
                            <div class="position-relative" style="height: 160px; background-color: #f8f9fa;">
                                @if (!string.IsNullOrEmpty(room.Image))
                                {
                                    <img src="@room.Image" alt="@room.RoomName"
                                         class="w-100 h-100 object-fit-cover" />
                                }
                                else
                                {
                                    <div class="w-100 h-100 d-flex align-items-center justify-content-center text-muted">
                                        <i class="bi bi-door-open" style="font-size: 3rem; opacity: 0.2;"></i>
                                    </div>
                                }
                                <span class="badge bg-success rounded-pill position-absolute top-0 end-0 m-2 px-2 py-1">
                                    <i class="bi bi-check-circle-fill me-1"></i>Có sẵn
                                </span>
                            </div>
                            <!-- Thông tin -->
                            <div class="card-body p-3">
                                <h6 class="fw-bold text-dark mb-1">@room.RoomName</h6>
                                <div class="d-flex align-items-center gap-1 text-muted small">
                                    <i class="bi bi-people-fill"></i>
                                    <span>@room.Capacity người</span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(room.Description))
                                {
                                    <p class="text-muted small mt-2 mb-0" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                        @room.Description
                                    </p>
                                }
                            </div>
                            <div class="card-footer bg-white border-0 px-3 pb-3 pt-0">
                                <span class="btn btn-outline-success btn-sm w-100 rounded-pill">
                                    <i class="bi bi-eye me-1"></i>Xem chi tiết
                                </span>
                            </div>
                        </a>
                    </div>
                }
            </div>
        </div>
    }

</div>

<!-- Modal Đặt Phòng -->
<div class="modal fade" id="bookingModal" tabindex="-1" aria-labelledby="bookingModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content border-0 rounded-4 shadow">
      <div class="modal-header bg-success text-white rounded-top-4 border-0">
        <h5 class="modal-title fw-bold" id="bookingModalLabel"><i class="bi bi-calendar-check me-2"></i>Đặt phòng: @Model.RoomName</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-4">
        <div class="row g-4">
            <!-- Quy định đặt phòng -->
            <div class="col-md-5">
                <div class="bg-light p-3 rounded-3 h-100 border">
                    <h6 class="fw-bold text-success mb-3"><i class="bi bi-journal-text me-2"></i>Quy định đặt phòng</h6>
                    <ul class="mb-0 text-muted small" style="padding-left: 1rem; line-height: 1.6;">
                        <li><strong class="text-dark">Khung giờ:</strong> 08:00 - 20:00. Mỗi ca 4 tiếng.</li>
                        <li><strong class="text-dark">Giới hạn:</strong> Tối đa 4 ca/tuần/sinh viên.</li>
                        <li><strong class="text-dark">Trùng lặp:</strong> Không thể đặt nhiều phòng cùng lúc.</li>
                        <li><strong class="text-dark">Đặt trước:</strong> Tối đa 7 ngày.</li>
                        <li class="text-danger"><strong class="text-danger">Lưu ý No-Show:</strong> Tự động hủy nếu trễ 15 phút. Vi phạm 3 lần/tháng khóa quyền 7 ngày.</li>
                    </ul>
                </div>
            </div>
            
            <!-- Chọn thời gian -->
            <div class="col-md-7">
                <div class="mb-3">
                    <label for="bookingDate" class="form-label fw-bold">Chọn ngày đặt</label>
                    <input type="date" class="form-control form-control-lg rounded-3" id="bookingDate" min="@DateTime.Now.ToString("yyyy-MM-dd")" max="@DateTime.Now.AddDays(5).ToString("yyyy-MM-dd")" value="@DateTime.Now.ToString("yyyy-MM-dd")">
                </div>
                
                <div class="mb-3">
                    <label class="form-label fw-bold d-flex justify-content-between">
                        <span>Chọn ca (Slot)</span>
                        <span id="loadingSlots" class="spinner-border spinner-border-sm text-success d-none" role="status"></span>
                    </label>
                    <div id="slotsContainer" class="d-flex flex-column gap-2">
                        <!-- Slots will be rendered here via JS -->
                        <div class="text-muted small fst-italic">Vui lòng chọn ngày để xem ca trống...</div>
                    </div>
                </div>
            </div>
        </div>
      </div>
      <div class="modal-footer border-top-0 pt-0 px-4 pb-4">
        <button type="button" class="btn btn-light rounded-pill px-4 fw-medium border" data-bs-dismiss="modal">Hủy</button>
        <button type="button" id="btnSubmitBooking" class="btn btn-success rounded-pill px-4 fw-bold shadow-sm" disabled>
            Xác nhận đặt phòng
        </button>
      </div>
    </div>
  </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            let selectedSlot = null;
            const roomId = '@Model.RoomId';
            
            // Hàm load slots từ API
            function loadSlots() {
                const date = $('#bookingDate').val();
                if (!date) return;
                
                $('#loadingSlots').removeClass('d-none');
                $('#slotsContainer').html('');
                $('#btnSubmitBooking').prop('disabled', true);
                selectedSlot = null;

                // Call MVC Proxy
                $.ajax({
                    url: `/Reservations/AvailableSlots?roomId=${roomId}&date=${date}`,
                    method: 'GET',
                    success: function(slots) {
                        $('#loadingSlots').addClass('d-none');
                        renderSlots(slots);
                    },
                    error: function() {
                        $('#loadingSlots').addClass('d-none');
                        $('#slotsContainer').html('<div class="text-danger small"><i class="bi bi-exclamation-triangle"></i> Lỗi khi tải dữ liệu ca.</div>');
                    }
                });
            }

            function formatTime(timeStr) {
                const d = new Date(timeStr);
                return d.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' });
            }

            function renderSlots(slots) {
                const container = $('#slotsContainer');
                container.empty();

                if (!slots || slots.length === 0) {
                    container.html('<div class="text-muted small">Không có ca nào trong ngày này.</div>');
                    return;
                }

                slots.forEach((slot, index) => {
                    const startStr = formatTime(slot.startTime);
                    const endStr = formatTime(slot.endTime);
                    const slotText = `Ca ${index + 1}: ${startStr} - ${endStr}`;
                    
                    if (slot.isAvailable) {
                        const btn = $(`<button type="button" class="btn btn-outline-success text-start rounded-3 fw-medium slot-btn" data-start="${slot.startTime}" data-end="${slot.endTime}">
                            <i class="bi bi-clock me-2"></i> ${slotText}
                        </button>`);
                        
                        btn.on('click', function() {
                            $('.slot-btn').removeClass('active btn-success text-white').addClass('btn-outline-success');
                            $(this).removeClass('btn-outline-success').addClass('active btn-success text-white');
                            
                            selectedSlot = {
                                startTime: $(this).data('start'),
                                endTime: $(this).data('end')
                            };
                            $('#btnSubmitBooking').prop('disabled', false);
                        });
                        
                        container.append(btn);
                    } else {
                        let reason = slot.reason;
                        if(slot.reason === 'Past') reason = 'Đã qua';
                        else if(slot.reason === 'Reserved') reason = 'Đã kín chỗ';
                        else if(slot.reason === 'Locked') reason = 'Khóa (Bảo trì)';
                        
                        container.append(`
                            <button type="button" class="btn btn-light text-start rounded-3 text-muted border" disabled>
                                <i class="bi bi-clock me-2"></i> <span class="text-decoration-line-through">${slotText}</span>
                                <span class="badge bg-secondary ms-2">${reason}</span>
                            </button>
                        `);
                    }
                });
            }

            // Sự kiện khi đổi ngày
            $('#bookingDate').on('change', loadSlots);

            // Tự động load khi mở modal
            $('#bookingModal').on('shown.bs.modal', function () {
                loadSlots();
            });

            // Gửi yêu cầu đặt phòng
            $('#btnSubmitBooking').on('click', function() {
                if (!selectedSlot) return;

                const readerId = '@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value';
                
                if (!readerId) {
                    alert('Bạn cần đăng nhập để đặt phòng!');
                    window.location.href = '/Account/Login';
                    return;
                }

                const payload = {
                    roomId: roomId,
                    readerId: readerId,
                    startTime: selectedSlot.startTime,
                    endTime: selectedSlot.endTime
                };

                const btn = $(this);
                const originalText = btn.text();
                btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Đang xử lý...');

                $.ajax({
                    url: '/Reservations/Create',
                    method: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(payload),
                    success: function(res) {
                        alert('Đặt phòng thành công! Trạng thái: Đã xác nhận.');
                        $('#bookingModal').modal('hide');
                    },
                    error: function(xhr) {
                        btn.prop('disabled', false).text(originalText);
                        let errorMsg = 'Có lỗi xảy ra khi đặt phòng.';
                        if (xhr.responseJSON && xhr.responseJSON.message) {
                            errorMsg = xhr.responseJSON.message;
                        }
                        if (xhr.responseJSON && xhr.responseJSON.requirePhone) {
                            if (confirm(errorMsg + '\n\nBấm OK để đến trang cập nhật hồ sơ.')) {
                                window.location.href = '/UserProfile/Index';
                            }
                        } else {
                            alert(errorMsg);
                        }
                    }
                });
            });
        });
    </script>
}

<style>
    .suggested-room-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .suggested-room-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 24px rgba(0,0,0,0.12) !important;
    }
</style>
