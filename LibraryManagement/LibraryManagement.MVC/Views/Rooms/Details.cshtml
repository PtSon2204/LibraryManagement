@model LibraryManagement.MVC.ViewModels.Room.RoomViewModel

@{
    ViewData["Title"] = Model.RoomName;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Phòng học & đọc</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.RoomName</li>
        </ol>
    </nav>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-5">
        <div class="row g-0">
            <div class="col-lg-6 position-relative" style="min-height: 400px; background-color: #f8f9fa;">
                @if (!string.IsNullOrEmpty(Model.Image))
                {
                    <img src="@Model.Image" alt="@Model.RoomName" class="w-100 h-100 object-fit-cover position-absolute top-0 start-0">
                }
                else
                {
                    <div class="w-100 h-100 d-flex justify-content-center align-items-center text-muted position-absolute top-0 start-0">
                        <i class="bi bi-image" style="font-size: 5rem; opacity: 0.2;"></i>
                    </div>
                }
                
                <div class="position-absolute top-0 start-0 m-4">
                    @if (Model.Status == "Available")
                    {
                        <span class="badge bg-success bg-opacity-90 rounded-pill px-3 py-2 fs-6 shadow-sm">
                            <i class="bi bi-check-circle-fill me-1"></i> Có sẵn
                        </span>
                    }
                    else if (Model.Status == "Occupied")
                    {
                        <span class="badge bg-danger bg-opacity-90 rounded-pill px-3 py-2 fs-6 shadow-sm">
                            <i class="bi bi-x-circle-fill me-1"></i> Đang sử dụng
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-warning bg-opacity-90 rounded-pill px-3 py-2 fs-6 text-dark shadow-sm">
                            <i class="bi bi-wrench-adjustable-circle-fill me-1"></i> Đang bảo trì
                        </span>
                    }
                </div>
            </div>
            
            <div class="col-lg-6 d-flex flex-column">
                <div class="card-body p-5 flex-grow-1">
                    <h1 class="card-title fw-bold text-dark mb-4">@Model.RoomName</h1>
                    
                    <div class="d-flex align-items-center mb-4 text-primary bg-primary bg-opacity-10 p-3 rounded-3 d-inline-flex">
                        <i class="bi bi-people-fill fs-4 me-3"></i>
                        <div>
                            <small class="d-block text-muted text-uppercase fw-bold" style="font-size: 0.75rem;">Sức chứa tối đa</small>
                            <span class="fs-5 fw-bold">@Model.Capacity người</span>
                        </div>
                    </div>

                    <h5 class="fw-bold mb-3 mt-4">Thông tin chi tiết</h5>
                    <div class="bg-light rounded-4 p-4 text-muted" style="min-height: 120px; line-height: 1.6;">
                        @if (string.IsNullOrWhiteSpace(Model.Description))
                        {
                            <span class="fst-italic opacity-75">Không có mô tả chi tiết cho phòng này.</span>
                        }
                        else
                        {
                            @Html.Raw(Model.Description.Replace("\n", "<br />"))
                        }
                    </div>
                </div>
                
                <div class="card-footer bg-white border-top p-4 p-lg-5 mt-auto">
                    <div class="d-flex gap-3 align-items-center">
                        <a asp-action="Index" class="btn btn-light btn-lg px-4 rounded-pill fw-medium border">
                            <i class="bi bi-arrow-left me-2"></i>Quay lại
                        </a>
                        
                        @if (Model.Status == "Available")
                        {
                            <!-- This could link to a booking page in the future -->
                            <button class="btn btn-primary btn-lg flex-grow-1 rounded-pill fw-bold shadow-sm" onclick="alert('Tính năng đặt phòng sẽ được cập nhật sớm!')">
                                <i class="bi bi-calendar-plus me-2"></i>Đặt phòng ngay
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-secondary btn-lg flex-grow-1 rounded-pill fw-bold" disabled>
                                <i class="bi bi-lock-fill me-2"></i>Hiện không thể đặt
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
