@model LibraryManagement.MVC.ViewModels.Room.RoomListViewModel

@{
    ViewData["Title"] = "Danh sách phòng học/đọc";
    Layout = "~/Views/Shared/_Layout.cshtml"; // Reader layout
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-2">Phòng học và phòng đọc</h2>
            <p class="text-muted mb-0">Tìm không gian học tập phù hợp với bạn</p>
        </div>
    </div>

    <!-- Search & Filter -->
    <div class="card border-0 shadow-sm rounded-4 mb-5">
        <div class="card-body p-4">
            <form method="get" asp-action="Index" class="row g-3">
                <div class="col-md-5">
                    <div class="input-group input-group-lg">
                        <span class="input-group-text bg-white border-end-0">
                            <i class="bi bi-search text-muted"></i>
                        </span>
                        <input type="text" name="search" class="form-control border-start-0 ps-0"
                               placeholder="Tìm theo tên phòng..." value="@Model.Search" />
                    </div>
                </div>
                <div class="col-md-4">
                    <select name="status" class="form-select form-select-lg">
                        <option value="">-- Tất cả trạng thái --</option>
                        <option value="Available" selected="@(Model.Status == "Available")">Có sẵn</option>
                        <option value="Occupied" selected="@(Model.Status == "Occupied")">Đang sử dụng</option>
                        <option value="Maintenance" selected="@(Model.Status == "Maintenance")">Đang bảo trì</option>
                    </select>
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary btn-lg flex-grow-1 fw-medium">
                        <i class="bi bi-search me-2"></i>Tìm kiếm
                    </button>
                    @if (!string.IsNullOrWhiteSpace(Model.Search) || !string.IsNullOrWhiteSpace(Model.Status))
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary btn-lg" title="Xóa lọc">
                            <i class="bi bi-x-lg"></i>
                        </a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- Room Cards -->
    @if (Model.Data.Count == 0)
    {
        <div class="text-center py-5 my-5">
            <i class="bi bi-door-open display-1 text-muted opacity-25"></i>
            <h4 class="mt-4 text-muted">Không tìm thấy phòng nào</h4>
            <p class="text-muted">Vui lòng thử lại với từ khóa tìm kiếm khác.</p>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-4 mb-5">
            @foreach (var room in Model.Data)
            {
                <div class="col">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden room-card transition-all" style="transition: transform 0.3s ease, box-shadow 0.3s ease;">
                        <div class="position-relative" style="height: 200px; background-color: #f8f9fa;">
                            @if (!string.IsNullOrEmpty(room.Image))
                            {
                                <img src="@room.Image" class="w-100 h-100 object-fit-cover" alt="@room.RoomName">
                            }
                            else
                            {
                                <div class="w-100 h-100 d-flex justify-content-center align-items-center text-muted">
                                    <i class="bi bi-image fs-1 opacity-50"></i>
                                </div>
                            }
                            
                            <!-- Status Badge -->
                            <div class="position-absolute top-0 end-0 m-3">
                                @if (room.Status == "Available")
                                {
                                    <span class="badge bg-success bg-opacity-90 rounded-pill px-3 py-2 border border-success border-opacity-50 shadow-sm">
                                        <i class="bi bi-check-circle-fill me-1"></i> Có sẵn
                                    </span>
                                }
                                else if (room.Status == "Occupied")
                                {
                                    <span class="badge bg-danger bg-opacity-90 rounded-pill px-3 py-2 border border-danger border-opacity-50 shadow-sm">
                                        <i class="bi bi-x-circle-fill me-1"></i> Đang dùng
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning bg-opacity-90 rounded-pill px-3 py-2 border border-warning border-opacity-50 shadow-sm text-dark">
                                        <i class="bi bi-wrench-adjustable-circle-fill me-1"></i> Bảo trì
                                    </span>
                                }
                            </div>
                        </div>
                        <div class="card-body p-4 d-flex flex-column">
                            <h5 class="card-title fw-bold text-dark mb-3 text-truncate" title="@room.RoomName">
                                @room.RoomName
                            </h5>
                            
                            <div class="mb-4 text-muted small flex-grow-1">
                                <div class="d-flex align-items-center mb-2">
                                    <i class="bi bi-people-fill text-primary me-2"></i>
                                    <span>Sức chứa: <strong>@room.Capacity người</strong></span>
                                </div>
                                <div class="d-flex align-items-start">
                                    <i class="bi bi-info-circle-fill text-primary me-2 mt-1"></i>
                                    <span class="text-truncate-2" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                        @(string.IsNullOrWhiteSpace(room.Description) ? "Không có mô tả" : room.Description)
                                    </span>
                                </div>
                            </div>
                            
                            <a asp-action="Details" asp-route-id="@room.RoomId" class="btn btn-outline-primary rounded-pill fw-medium w-100 stretched-link">
                                Xem chi tiết <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Page navigation" class="mt-4">
                <ul class="pagination pagination-lg justify-content-center border-0 gap-2">
                    <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                        <a class="page-link rounded-circle border-0 text-dark bg-light custom-hover"
                           asp-action="Index"
                           asp-route-search="@Model.Search"
                           asp-route-status="@Model.Status"
                           asp-route-pageNumber="@(Model.PageNumber - 1)">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                    </li>
                    @for (int i = Math.Max(1, Model.PageNumber - 2); i <= Math.Min(Model.TotalPages, Model.PageNumber + 2); i++)
                    {
                        <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                            <a class="page-link rounded-circle border-0 @(i == Model.PageNumber ? "bg-primary text-white shadow" : "text-dark bg-light custom-hover")"
                               asp-action="Index"
                               asp-route-search="@Model.Search"
                               asp-route-status="@Model.Status"
                               asp-route-pageNumber="@i"
                               style="width: 46px; height: 46px; display: flex; align-items: center; justify-content: center;">
                                @i
                            </a>
                        </li>
                    }
                    <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link rounded-circle border-0 text-dark bg-light custom-hover"
                           asp-action="Index"
                           asp-route-search="@Model.Search"
                           asp-route-status="@Model.Status"
                           asp-route-pageNumber="@(Model.PageNumber + 1)">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        }
    }
</div>

<style>
    .room-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important;
    }
    .custom-hover:hover {
        background-color: #e9ecef !important;
    }
</style>
