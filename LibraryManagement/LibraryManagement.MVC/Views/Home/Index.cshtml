@model LibraryManagement.MVC.ViewModels.Home.HomePageViewModel

@{
    ViewData["Title"] = "Trang chủ";
}

<!-- Hero Section -->
<section class="hero-section">
    <div class="container">
        <h1 class="hero-title">
            Thư viện <span class="text-brand">sách online</span>
        </h1>
        <p class="hero-subtitle">
            Thư viện sách cộng đồng cho phép người dùng mượn/trả sách một cách tiện lợi.<br />
            Chúng tôi có rất nhiều sách thuộc nhiều thể loại, bạn đọc có thể xem, đặt sách trước dễ dàng.
        </p>
        
        <form class="search-box" asp-controller="Books" asp-action="Index" method="get">
            <i class="bi bi-search position-absolute top-50 translate-middle-y ms-3 text-muted"></i>
            <input type="text" name="Title" placeholder="Tìm kiếm..." class="ps-5" />
            <button type="submit" class="btn-search">Tìm kiếm</button>
        </form>
    </div>
</section>

<!-- Content Section -->
<div class="container mt-5">
    <!-- Ebooks Section -->
    <h2 class="section-heading">Sách mới cập nhật</h2>
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-5 g-4 mb-5">
        @if (Model.LatestBooks.Any())
        {
            @foreach (var book in Model.LatestBooks)
            {
                <div class="col">
                    <div class="book-card">
                        <div class="book-cover">
                            <span class="book-badge">Book</span>
                            <img src="@(book.CoverImageUrl ?? "https://via.placeholder.com/300x420/e2e8f0/64748b?text=Book")" alt="@book.Title">
                        </div>
                        <div class="book-info">
                            <h3 class="book-title">@book.Title</h3>
                            <div class="book-author">@(book.PublisherName ?? "Chưa có nhà xuất bản")</div>
                            <a class="btn btn-sm btn-outline-brand mt-2" asp-controller="Books" asp-action="Details" asp-route-id="@book.BookId">Xem chi tiết</a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="alert alert-info">Chưa có sách để hiển thị.</div>
            </div>
        }
    </div>

    <!-- Audiobooks Section -->
    <h2 class="section-heading">Sách nói mới cập nhật</h2>
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-5 g-4 mb-5">
        <!-- Sample Book 1 -->
        <div class="col">
            <div class="book-card">
                <div class="book-cover">
                    <span class="book-badge audiobook">Audiobook</span>
                    <img src="https://via.placeholder.com/300x420/e2e8f0/64748b?text=99+Dieu" alt="99 Điều">
                </div>
                <div class="book-info">
                    <h3 class="book-title">99 Điều Không Đáng Bận Tâm</h3>
                    <div class="book-author">Nhiều tác giả</div>
                </div>
            </div>
        </div>
        <!-- Sample Book 2 -->
        <div class="col">
            <div class="book-card">
                <div class="book-cover">
                    <span class="book-badge audiobook">Audiobook</span>
                    <img src="https://via.placeholder.com/300x420/e2e8f0/64748b?text=Ban+Nang" alt="Bản Năng">
                </div>
                <div class="book-info">
                    <h3 class="book-title">Bản Năng</h3>
                    <div class="book-author">Mitsuyo Kakuta</div>
                </div>
            </div>
        </div>
        <!-- Sample Book 3 -->
        <div class="col">
            <div class="book-card">
                <div class="book-cover">
                    <span class="book-badge audiobook">Audiobook</span>
                    <img src="https://via.placeholder.com/300x420/e2e8f0/64748b?text=Power+of+Now" alt="Sức Mạnh">
                </div>
                <div class="book-info">
                    <h3 class="book-title">Sức Mạnh Của Hiện Tại</h3>
                    <div class="book-author">Eckhart Tolle</div>
                </div>
            </div>
        </div>
        <!-- Sample Book 4 -->
        <div class="col">
            <div class="book-card">
                <div class="book-cover">
                    <span class="book-badge audiobook">Audiobook</span>
                    <img src="https://via.placeholder.com/300x420/e2e8f0/64748b?text=100+Y+Tuong" alt="100 Ý Tưởng">
                </div>
                <div class="book-info">
                    <h3 class="book-title">100 Ý Tưởng Tiếp Thị Tuyệt Hay</h3>
                    <div class="book-author">Jim Blythe</div>
                </div>
            </div>
        </div>
        <!-- Sample Book 5 -->
        <div class="col">
            <div class="book-card">
                <div class="book-cover">
                    <span class="book-badge audiobook">Audiobook</span>
                    <img src="https://via.placeholder.com/300x420/e2e8f0/64748b?text=Giai+Phap" alt="Giải Pháp">
                </div>
                <div class="book-info">
                    <h3 class="book-title">Giải Pháp Đột Phá</h3>
                    <div class="book-author">Jay Abraham</div>
                </div>
            </div>
        </div>
    </div>
</div>
